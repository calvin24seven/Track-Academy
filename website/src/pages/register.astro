---
import BaseLayout from '../layouts/BaseLayout.astro';
import SimpleHero from '../components/sections/SimpleHero.astro';
import Button from '../components/ui/Button.astro';
import SignupDesk from '../assets/website-2026/signup-desk-welcoming.jpg';

const registrationUrl = 'https://app.upshot.org.uk/signup/c1ac4dca/39e743a525f9f4b5/';
const seo = {
  title: 'Register Your Child — Track Academy',
  description: 'Register your child for Track Academy through our secure Upshot registration system.',
};
---

<BaseLayout {...seo}>
  <SimpleHero image={SignupDesk} title="Register Your Child" lead="£25 per term. Free if on financial support." />
  <section class="bg-[var(--color-paper)] py-[clamp(4rem,10vw,8rem)]">
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 text-center lg:px-8">
      <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[-0.05em] text-[var(--color-track-orange)]">Secure registration</p>
      <h2 class="font-heading text-[clamp(1.75rem,5vw,3rem)] font-500 leading-[1.05] tracking-[-0.02em] text-[var(--color-track-blue)]">Continue to our registration system.</h2>
      <p class="mx-auto mt-5 max-w-xl font-body text-lg leading-[1.6] text-[var(--color-grey-700)]">Registration is completed securely in Upshot. You will be able to provide your child’s details, contact information, medical and emergency contacts, and consent information there.</p>
      <div class="mt-9"><Button href={registrationUrl} label="Register your child in Upshot" variant="primary" size="large" external /></div>
      <p class="mt-5 font-body text-sm text-[var(--color-grey-500)]">The registration form opens in a new tab.</p>
    </div>
  </section>
</BaseLayout>
