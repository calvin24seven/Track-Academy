---
import BaseLayout from '../layouts/BaseLayout.astro';
import SimpleHero from '../components/sections/SimpleHero.astro';
import GirlSmiling from '../assets/stories/girl-smiling.jpg';

const UPSHOT_SIGNUP_URL = 'https://app.upshot.org.uk/signup/c1ac4dca/39e743a525f9f4b5/';

const seo = {
  title: 'Register Your Child — Track Academy',
  description:
    'Register your child for athletics, education and mentoring at Track Academy in Brent using our secure Upshot registration form.',
};

const registrationSections = [
  'Your child’s identity and contact details',
  'Address and demographic information',
  'Emergency contacts and medical information',
  'Education and additional support information',
  'Membership, fees and communication preferences',
  'Consent, Track Academy terms and data protection',
];
---

<BaseLayout {...seo}>
  <SimpleHero
    image={GirlSmiling}
    title="Register Your Child"
    lead="Complete Track Academy’s official registration securely through Upshot."
  />

  <section class="bg-[var(--color-paper)] py-[clamp(3rem,8vw,6rem)]">
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 lg:px-8">
      <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[-0.05em] text-[var(--color-track-orange)]">
        Official registration
      </p>
      <h2 class="max-w-2xl font-heading text-[clamp(1.75rem,5vw,3rem)] font-500 leading-[1.1] tracking-[-0.01em] text-[var(--color-track-blue)]">
        Register through Upshot.
      </h2>
      <p class="mt-5 max-w-2xl font-body text-[clamp(1rem,1.5vw,1.125rem)] leading-[1.65] text-[var(--color-grey-700)]">
        Track Academy uses Upshot to manage youth registrations and programme information. Your registration is only complete once the Upshot form has been submitted successfully.
      </p>

      <div class="mt-8 border-l-4 border-[var(--color-track-orange)] bg-white p-6 sm:p-8">
        <p class="font-body text-sm font-semibold uppercase tracking-[0.05em] text-[var(--color-track-orange)]">Before you start</p>
        <p class="mt-3 font-body leading-[1.65] text-[var(--color-grey-700)]">
          The form asks for information Track Academy needs to support young people safely, including emergency contacts, medical information, education details, membership choices and consent.
        </p>
        <ul class="mt-5 space-y-2">
          {registrationSections.map((item) => (
            <li class="flex items-start gap-3 font-body text-sm leading-[1.55] text-[var(--color-grey-700)]">
              <span class="mt-[0.55rem] h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-track-orange)]"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a
          href={UPSHOT_SIGNUP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 items-center justify-center bg-[var(--color-track-orange)] px-8 py-3.5 font-body text-sm font-semibold uppercase tracking-wide text-white transition-all duration-150 ease-[var(--ease-sprint)] hover:bg-[var(--color-accent-dark)] focus-visible:outline-offset-4 active:scale-[0.98]"
        >
          Start registration on Upshot
          <span aria-hidden="true" class="ml-2">↗</span>
        </a>
        <a href="/privacy" class="font-body text-sm font-semibold text-[var(--color-track-blue)] underline decoration-[var(--color-track-orange)] decoration-2 underline-offset-4 hover:text-[var(--color-track-orange)]">
          Read our Privacy Policy
        </a>
      </div>

      <p class="mt-5 max-w-2xl font-body text-sm leading-[1.6] text-[var(--color-grey-500)]">
        Upshot opens in a new tab. If you have difficulty completing the form, contact Track Academy at <a href="mailto:admin@trackacademy.co.uk" class="underline underline-offset-2 hover:text-[var(--color-track-blue)]">admin@trackacademy.co.uk</a> or <a href="tel:07956715052" class="underline underline-offset-2 hover:text-[var(--color-track-blue)]">07956 715052</a>.
      </p>
    </div>
  </section>
</BaseLayout>
