---
/**
 * /protect-the-track/dashboard — private campaign dashboard.
 * Sign-in by magic link; only emails in public.campaign_admins can see data (enforced by RLS).
 */
import '../../styles/global.css';

const card = 'bg-white p-5 border border-[var(--color-grey-300)]';
const h = 'font-heading text-xl font-500 text-[var(--color-track-blue)]';
const input = 'w-full border border-[var(--color-grey-300)] bg-white px-3 py-2 font-body text-sm';
const btn = 'bg-[var(--color-track-orange)] px-4 py-2 font-body text-sm font-600 text-white hover:bg-[var(--color-accent-dark)] disabled:opacity-50';
const btnGhost = 'border border-[var(--color-track-blue)] px-3 py-1.5 font-body text-xs font-600 text-[var(--color-track-blue)] hover:bg-[var(--color-track-blue)] hover:text-white';
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Campaign dashboard | Protect Brent Athletics</title>
  <link rel="icon" type="image/png" href="/logo.png" />
</head>
<body class="bg-[var(--color-grey-100)] font-body text-[var(--color-grey-900)]">
  <header class="bg-[var(--color-track-navy)] px-6 py-4 text-white">
    <div class="mx-auto flex max-w-[1400px] items-center justify-between">
      <p class="font-heading text-lg">Protect Brent Athletics · Dashboard</p>
      <div class="flex items-center gap-4 text-sm">
        <span data-who class="text-white/70"></span>
        <button data-signout hidden class="underline">Sign out</button>
      </div>
    </div>
  </header>

  <!-- Sign in -->
  <main class="mx-auto max-w-[1400px] p-6" data-signin hidden>
    <div class={`${card} mx-auto max-w-md`}>
      <h1 class={h}>Sign in</h1>
      <p class="mt-2 text-sm text-[var(--color-grey-700)]">We’ll email you a sign-in link. Only campaign admins can see data.</p>
      <form id="signin" class="mt-4 grid gap-3">
        <input class={input} type="email" name="email" required placeholder="you@trackacademy.co.uk" />
        <button class={btn}>Email me a link</button>
        <p class="text-sm" data-msg></p>
      </form>
    </div>
  </main>

  <main class="mx-auto grid max-w-[1400px] gap-6 p-6" data-app hidden>
    <p class="text-sm text-[var(--color-error)]" data-error></p>

    <!-- Totals -->
    <section class="grid grid-cols-2 gap-3 md:grid-cols-4 xl:grid-cols-8" data-totals></section>

    <div class="grid gap-6 lg:grid-cols-3">
      <section class={card}>
        <h2 class={h}>Daily actions</h2>
        <div class="mt-4 space-y-1 text-sm" data-daily></div>
      </section>
      <section class={card}>
        <h2 class={h}>Which partner or channel drove it</h2>
        <p class="mt-1 text-xs text-[var(--color-grey-500)]">Give each partner their own link, e.g. <code>/protect-the-track?ref=qph</code></p>
        <table class="mt-3 w-full text-sm" data-refs></table>
        <form id="reflink" class="mt-4 flex gap-2">
          <input class={input} name="code" placeholder="partner code, e.g. ea" pattern="[a-z0-9_-]+" required />
          <button class={btnGhost}>Make link</button>
        </form>
        <p class="mt-2 break-all text-xs" data-reflink></p>
      </section>
      <section class={card}>
        <h2 class={h}>Signatures by Brent ward</h2>
        <p class="mt-1 text-xs text-[var(--color-grey-500)]">Send each ward’s councillors their own number.</p>
        <table class="mt-3 w-full text-sm" data-wards></table>
      </section>
    </div>

    <!-- Survey -->
    <section class={card}>
      <h2 class={h}>Membership survey</h2>
      <div class="mt-3 grid gap-4 text-sm md:grid-cols-3" data-survey></div>
      <div class="mt-4 bg-[var(--color-grey-100)] p-4 text-sm leading-[1.6]" data-survey-wording></div>
    </section>

    <!-- Stakeholder log -->
    <section class={card}>
      <h2 class={h}>Councillor and stakeholder responses</h2>
      <p class="mt-1 text-xs text-[var(--color-grey-500)]">Log every reply, meeting and call. Anything with a due date shows at the top.</p>
      <form id="log" class="mt-4 grid gap-3 md:grid-cols-6">
        <input class={input} name="stakeholder" placeholder="Who (e.g. Cllr Jake Rubin)" required list="stakeholders" />
        <input class={input} name="organisation" placeholder="Organisation" />
        <select class={input} name="channel"><option>email</option><option>meeting</option><option>call</option><option>council meeting</option><option>press</option><option>letter</option></select>
        <select class={input} name="stance">
          <option value="no_response">No response</option><option value="champion">Champion</option><option value="supportive">Supportive</option>
          <option value="neutral">Neutral</option><option value="opposed">Opposed</option>
        </select>
        <input class={input} name="next_step_due" type="date" />
        <input class={input} name="next_step" placeholder="Next step" />
        <textarea class={`${input} md:col-span-5`} name="summary" rows="2" placeholder="What they said"></textarea>
        <button class={btn}>Add entry</button>
        <datalist id="stakeholders"></datalist>
      </form>
      <div class="mt-4 overflow-x-auto"><table class="w-full text-sm" data-log></table></div>
    </section>

    <div class="grid gap-6 lg:grid-cols-2">
      <section class={card}>
        <h2 class={h}>Stories to review</h2>
        <p class="mt-1 text-xs text-[var(--color-grey-500)]">The DSL must check any story about an under-18 before approving.</p>
        <div class="mt-4 space-y-3" data-stories></div>
      </section>
      <section class={card}>
        <h2 class={h}>Offers of help</h2>
        <div class="mt-4 space-y-3" data-offers></div>
      </section>
    </div>

    <section class={card}>
      <h2 class={h}>Exports</h2>
      <p class="mt-1 text-sm text-[var(--color-grey-700)]">The petition export has the name, postcode and ward of each signer, as Brent’s petition scheme asks for.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button class={btnGhost} data-export="petition_signatures?select=created_at,full_name,postcode,ward,in_brent,relationship,ref&consent_council=eq.true&order=created_at">Petition (for council)</button>
        <button class={btnGhost} data-export="petition_signatures?select=full_name,email,ward,relationship&consent_updates=eq.true&order=created_at">Opted-in supporters (for Sender)</button>
        <button class={btnGhost} data-export="membership_survey?select=*&order=created_at">Survey</button>
        <button class={btnGhost} data-export="stakeholder_log?select=*&order=created_at">Stakeholder log</button>
        <button class={btnGhost} data-export="campaign_offers?select=*&order=created_at">Offers</button>
      </div>
    </section>
  </main>

  <script>
    import { rpc, select, patch, insertAuthed, sendMagicLink, supabaseReady } from '../../lib/campaign-client';
    import { primaryTargets, wardCouncillors } from '../../data/campaign';

    const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
    const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const fmt = (n: number) => Number(n || 0).toLocaleString('en-GB');
    const gbp = (n: number) => `£${Math.round(n || 0).toLocaleString('en-GB')}`;

    // ---- Auth (token from magic-link redirect hash) ----
    const hash = new URLSearchParams(location.hash.slice(1));
    if (hash.get('access_token')) {
      sessionStorage.setItem('ptt_token', hash.get('access_token')!);
      history.replaceState(null, '', location.pathname);
    }
    const token = sessionStorage.getItem('ptt_token');
    function claims(t: string) { try { return JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))); } catch { return null; } }
    const c = token ? claims(token) : null;
    const valid = c && c.exp * 1000 > Date.now();

    if (!supabaseReady) {
      document.body.insertAdjacentHTML('beforeend', '<p class="p-6">Supabase is not configured. Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY.</p>');
    } else if (!valid) {
      $('[data-signin]').hidden = false;
      $<HTMLFormElement>('#signin').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = String(new FormData(e.target as HTMLFormElement).get('email'));
        try { await sendMagicLink(email, location.origin + location.pathname); $('[data-msg]').textContent = 'Check your inbox.'; }
        catch (err) { $('[data-msg]').textContent = String(err); }
      });
    } else {
      $('[data-app]').hidden = false;
      $('[data-who]').textContent = c.email;
      $('[data-signout]').hidden = false;
      $('[data-signout]').addEventListener('click', () => { sessionStorage.removeItem('ptt_token'); location.reload(); });
      load();
    }

    type Admin = {
      totals: Record<string, number>;
      by_ward: { ward: string; signatures: number }[];
      by_ref: { ref: string; petition: number; emails: number; total: number }[];
      daily: { day: string; petition: number; emails: number }[];
      survey: Record<string, number>;
    };

    async function load() {
      try {
        const s = await rpc<Admin>('campaign_admin_stats', {}, token!);
        if (!s) return;
        renderTotals(s);
        renderDaily(s);
        renderRefs(s);
        renderWards(s);
        renderSurvey(s);
        await Promise.all([renderLog(), renderStories(), renderOffers()]);
      } catch (e) {
        $('[data-error]').textContent = `Couldn’t load data: ${e}. If this says "not authorised", ask for your email to be added to campaign_admins.`;
      }
    }

    function renderTotals(s: Admin) {
      const t = s.totals;
      const tiles: [string, number, string?][] = [
        ['Signatures', t.petition], ['From Brent', t.petition_brent],
        ['Emails sent', t.emails_sent, `${fmt(t.emails_opened)} opened`],
        ['Shares', t.shares], ['Opted in', t.petition_updates_optin],
        ['Stories pending', t.stories_pending], ['Offers', t.offers], ['Survey', t.survey],
      ];
      $('[data-totals]').innerHTML = tiles.map(([l, v, sub]) => `
        <div class="bg-white p-4 border border-[var(--color-grey-300)]">
          <p class="text-xs uppercase tracking-wide text-[var(--color-grey-500)]">${l}</p>
          <p class="font-heading text-3xl text-[var(--color-track-blue)] tabular-nums">${fmt(v)}</p>
          ${sub ? `<p class="text-xs text-[var(--color-grey-500)]">${sub}</p>` : ''}
        </div>`).join('');
    }

    function renderDaily(s: Admin) {
      const max = Math.max(1, ...s.daily.map((d) => d.petition + d.emails));
      $('[data-daily]').innerHTML = s.daily.slice(-21).map((d) => {
        const p = (d.petition / max) * 100, e = (d.emails / max) * 100;
        return `<div class="flex items-center gap-2"><span class="w-20 text-xs tabular-nums text-[var(--color-grey-500)]">${new Date(d.day).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' })}</span>
          <div class="flex h-3 flex-1 gap-px"><div style="width:${p}%" class="bg-[var(--color-track-blue)]" title="${d.petition} signatures"></div><div style="width:${e}%" class="bg-[var(--color-track-orange)]" title="${d.emails} emails"></div></div>
          <span class="w-16 text-right text-xs tabular-nums">${d.petition} · ${d.emails}</span></div>`;
      }).join('') + '<p class="mt-2 text-xs text-[var(--color-grey-500)]"><span class="text-[var(--color-track-blue)]">■</span> signatures <span class="text-[var(--color-track-orange)]">■</span> emails sent</p>';
    }

    function renderRefs(s: Admin) {
      $('[data-refs]').innerHTML = '<tr class="text-left text-xs text-[var(--color-grey-500)]"><th>Source</th><th class="text-right">Signed</th><th class="text-right">Emailed</th></tr>' +
        s.by_ref.map((r) => `<tr class="border-t border-[var(--color-grey-100)]"><td class="py-1">${esc(r.ref)}</td><td class="text-right tabular-nums">${fmt(r.petition)}</td><td class="text-right tabular-nums">${fmt(r.emails)}</td></tr>`).join('');
      $<HTMLFormElement>('#reflink').onsubmit = (e) => {
        e.preventDefault();
        const code = String(new FormData(e.target as HTMLFormElement).get('code')).toLowerCase();
        $('[data-reflink]').textContent = `${location.origin}/protect-the-track?ref=${code}`;
      };
    }

    function renderWards(s: Admin) {
      const norm = (x: string) => x.toLowerCase().replace(/&/g, 'and').replace(/[^a-z]/g, '');
      const byNorm = new Map(Object.entries(wardCouncillors).map(([k, v]) => [norm(k), v]));
      $('[data-wards]').innerHTML = s.by_ward.map((w) => {
        const cllrs = (byNorm.get(norm(w.ward)) ?? []).map((x) => x.name.replace('Cllr ', '')).join(', ');
        return `<tr class="border-t border-[var(--color-grey-100)]"><td class="py-1"><span class="font-600">${esc(w.ward)}</span><br><span class="text-xs text-[var(--color-grey-500)]">${esc(cllrs)}</span></td><td class="text-right align-top tabular-nums">${fmt(w.signatures)}</td></tr>`;
      }).join('');
    }

    function renderSurvey(s: Admin) {
      const v = s.survey;
      const pct = (a: number, b: number) => (b ? Math.round((a / b) * 100) : 0);
      $('[data-survey]').innerHTML = `
        <div><p class="font-600">Members: ${fmt(v.members)}</p><p>Would consider cancelling: yes ${fmt(v.cancel_yes)} (${pct(v.cancel_yes, v.members)}%), maybe ${fmt(v.cancel_maybe)} (${pct(v.cancel_maybe, v.members)}%), no ${fmt(v.cancel_no)}</p></div>
        <div><p class="font-600">Non-members: ${fmt(v.non_members)}</p><p>Would consider joining: yes ${fmt(v.join_yes)} (${pct(v.join_yes, v.non_members)}%), maybe ${fmt(v.join_maybe)} (${pct(v.join_maybe, v.non_members)}%), no ${fmt(v.join_no)}</p></div>
        <div><p class="font-600">Membership income linked to “yes”: ${gbp(v.annual_revenue_at_risk_yes)}/yr</p><p>Plus “maybe”: ${gbp(v.annual_revenue_at_risk_maybe)}/yr. ${fmt(v.uses_centre_during_sessions)} parents use the centre during sessions.</p></div>`;
      $('[data-survey-wording]').innerHTML = v.members + v.non_members < 30
        ? 'Wait for at least 30 responses before quoting figures.'
        : `<p class="font-600">Suggested wording (use “consider” and “suggest”, never “will” or “prove”):</p>
           <p class="mt-1">“Of ${fmt(v.members)} responses from families who hold a Willesden Sports Centre membership, ${pct(v.cancel_yes + v.cancel_maybe, v.members)}% said they would or might consider cancelling it if the indoor track is removed, representing around ${gbp(v.annual_revenue_at_risk_yes + v.annual_revenue_at_risk_maybe)} a year in membership fees. Of ${fmt(v.non_members)} non-members, ${pct(v.join_yes + v.join_maybe, v.non_members)}% said they would or might consider joining if the track were kept. These are indicative figures from a self-selecting sample, but they suggest the council’s financial case has not accounted for the impact on existing members.”</p>`;
    }

    async function renderLog() {
      const dl = $('#stakeholders');
      const names = new Set([...primaryTargets.map((t) => t.name), ...Object.values(wardCouncillors).flat().map((x) => x.name),
        'Eugene Minogue', 'Ruth du Plessis', 'England Athletics', 'Sport England', 'London Sport', 'Brent and Kilburn Times', 'MyLondon (Grant Williams)']);
      dl.innerHTML = [...names].map((n) => `<option value="${esc(n)}">`).join('');

      const rows = await select<any[]>('stakeholder_log?select=*&order=next_step_due.asc.nullslast,created_at.desc', token!);
      const stanceCls: Record<string, string> = { champion: 'bg-green-100', supportive: 'bg-green-50', neutral: 'bg-yellow-50', opposed: 'bg-red-50', no_response: 'bg-[var(--color-grey-100)]' };
      const today = new Date().toISOString().slice(0, 10);
      $('[data-log]').innerHTML = '<tr class="text-left text-xs text-[var(--color-grey-500)]"><th>When</th><th>Who</th><th>Stance</th><th>What they said</th><th>Next step</th><th>Due</th></tr>' +
        rows.map((r) => `<tr class="border-t border-[var(--color-grey-100)] align-top ${r.next_step_due && r.next_step_due <= today ? 'font-600' : ''}">
          <td class="py-2 pr-3 text-xs whitespace-nowrap">${new Date(r.created_at).toLocaleDateString('en-GB')}</td>
          <td class="pr-3">${esc(r.stakeholder)}<br><span class="text-xs text-[var(--color-grey-500)]">${esc(r.organisation)} · ${esc(r.channel)}</span></td>
          <td class="pr-3"><span class="px-2 py-0.5 text-xs ${stanceCls[r.stance] ?? ''}">${esc(r.stance.replace('_', ' '))}</span></td>
          <td class="pr-3">${esc(r.summary)}</td><td class="pr-3">${esc(r.next_step)}</td>
          <td class="text-xs whitespace-nowrap ${r.next_step_due && r.next_step_due <= today ? 'text-[var(--color-error)]' : ''}">${esc(r.next_step_due)}</td></tr>`).join('');

      $<HTMLFormElement>('#log').onsubmit = async (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        const fd = Object.fromEntries(new FormData(f));
        for (const k of Object.keys(fd)) if (fd[k] === '') delete fd[k];
        await insertAuthed('stakeholder_log', fd, token!);
        f.reset();
        renderLog();
      };
    }

    async function renderStories() {
      const rows = await select<any[]>('campaign_stories?select=*&status=eq.pending&order=created_at', token!);
      const age: Record<string, string> = { under_13: 'Under 13', '13_17': '13–17', '18_plus': '18+', unknown: 'Child, age not given' };
      const wrap = $('[data-stories]');
      wrap.innerHTML = rows.length ? rows.map((r) => `
        <div class="border border-[var(--color-grey-300)] p-3 text-sm" data-id="${r.id}">
          <p class="text-xs text-[var(--color-grey-500)]">${esc(r.display_name)} · ${esc(r.relationship)} · ${age[r.age_band]} ${r.age_band !== '18_plus' ? '· <b class="text-[var(--color-error)]">DSL check needed</b>' : ''}
            · publish: ${r.consent_publish ? 'yes' : '<b>no</b>'} · press: ${r.media_ok ? 'yes' : 'no'} ${r.contact_email ? '· ' + esc(r.contact_email) : ''}</p>
          <p class="mt-1 whitespace-pre-wrap">${esc(r.story)}</p>
          <div class="mt-2 flex gap-2"><button class="${'border border-green-700 px-2 py-1 text-xs text-green-800'}" data-act="approved">Approve</button><button class="border border-[var(--color-error)] px-2 py-1 text-xs text-[var(--color-error)]" data-act="rejected">Reject</button></div>
        </div>`).join('') : '<p class="text-sm text-[var(--color-grey-500)]">Nothing waiting.</p>';
      wrap.onclick = async (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
        if (!b) return;
        const id = b.closest<HTMLElement>('[data-id]')!.dataset.id;
        await patch(`campaign_stories?id=eq.${id}`, { status: b.dataset.act, reviewed_by: c.email, reviewed_at: new Date().toISOString() }, token!);
        renderStories();
      };
    }

    async function renderOffers() {
      const rows = await select<any[]>('campaign_offers?select=*&order=created_at.desc', token!);
      const wrap = $('[data-offers]');
      wrap.innerHTML = rows.length ? rows.map((r) => `
        <div class="border border-[var(--color-grey-300)] p-3 text-sm" data-id="${r.id}">
          <p><b>${esc(r.full_name)}</b> · <a class="underline" href="mailto:${esc(r.email)}">${esc(r.email)}</a> ${r.phone ? '· ' + esc(r.phone) : ''}</p>
          <p class="text-xs text-[var(--color-grey-500)]">${esc((r.skills || []).join(', '))}</p>
          <p class="mt-1">${esc(r.details)}</p>
          <select class="mt-2 border px-2 py-1 text-xs" data-status>${['new', 'contacted', 'active', 'not_needed'].map((s) => `<option ${s === r.status ? 'selected' : ''}>${s}</option>`).join('')}</select>
        </div>`).join('') : '<p class="text-sm text-[var(--color-grey-500)]">No offers yet.</p>';
      wrap.onchange = async (e) => {
        const sel = e.target as HTMLSelectElement;
        if (!sel.matches('[data-status]')) return;
        await patch(`campaign_offers?id=eq.${sel.closest<HTMLElement>('[data-id]')!.dataset.id}`, { status: sel.value }, token!);
      };
    }

    // ---- CSV export ----
    document.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-export]');
      if (!b) return;
      const rows = await select<any[]>(b.dataset.export!, token!);
      if (!rows.length) return alert('Nothing to export yet.');
      const cols = Object.keys(rows[0]);
      const cell = (v: unknown) => `"${String(Array.isArray(v) ? v.join('; ') : v ?? '').replace(/"/g, '""')}"`;
      const csv = [cols.join(','), ...rows.map((r) => cols.map((k) => cell(r[k])).join(','))].join('\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
      a.download = `${b.dataset.export!.split('?')[0]}-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
    });
  </script>
</body>
</html>
