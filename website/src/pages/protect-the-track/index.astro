---
/**
 * /protect-the-track — Protect Brent Athletics campaign hub.
 * Action ladder: email councillors -> sign petition -> share -> story / skills / survey.
 * Copy lives in src/data/campaign.ts. Data goes to Supabase (see supabase/migrations).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimpleHero from '../../components/sections/SimpleHero.astro';
import HeroImage from '../../assets/hero/indoor-track-willesden.webp';
import { campaign, context, facts, asks, primaryTargets, relationships, skillOptions } from '../../data/campaign';

const seo = {
  title: 'Protect Brent Athletics | Save the indoor track',
  description:
    'Brent Council is removing the indoor track at Willesden Sports Centre, used by 400+ young people. Email your councillors and sign the petition in two minutes.',
};

const input =
  'w-full border border-[var(--color-grey-300)] bg-white px-4 py-3 font-body text-base text-[var(--color-grey-900)] focus:border-[var(--color-track-blue)] focus:outline-2 focus:outline-offset-0 focus:outline-[var(--color-track-orange)]';
const labelCls = 'mb-2 block font-body text-sm font-600 text-[var(--color-grey-900)]';
const btn =
  'inline-flex items-center justify-center bg-[var(--color-track-orange)] px-6 py-4 font-body text-sm font-semibold uppercase tracking-wide text-white transition-all duration-150 hover:bg-[var(--color-accent-dark)] active:scale-[0.98] disabled:opacity-50';
const btnGhost =
  'inline-flex items-center justify-center border-2 border-[var(--color-track-blue)] px-5 py-3 font-body text-sm font-semibold uppercase tracking-wide text-[var(--color-track-blue)] transition-all duration-150 hover:bg-[var(--color-track-blue)] hover:text-white active:scale-[0.98]';
const eyebrow = 'mb-3 font-body text-sm font-semibold uppercase tracking-[0.05em] text-[var(--color-track-orange)]';
const h2 = 'font-heading text-[clamp(1.5rem,4vw,2.5rem)] font-500 leading-[1.1] tracking-[-0.01em] text-[var(--color-track-blue)]';
---

<BaseLayout {...seo} hideNewsletterPopup hideMobileCta>
  <SimpleHero image={HeroImage} title={campaign.headline} lead="400+ young people train on this track. It takes two minutes to tell the council it matters." />

  <!-- Live numbers + jump links -->
  <section class="sticky top-0 z-30 border-b border-[var(--color-grey-300)] bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-[var(--container-content)] flex-wrap items-center justify-between gap-3 px-6 py-3 lg:px-8">
      <p class="font-body text-sm text-[var(--color-grey-700)]" data-live-counter hidden>
        <strong class="font-heading text-lg text-[var(--color-track-blue)] tabular-nums" data-stat="emails_sent">0</strong> emails sent ·
        <strong class="font-heading text-lg text-[var(--color-track-blue)] tabular-nums" data-stat="petition">0</strong> signatures
      </p>
      <nav class="flex gap-2 font-body text-sm font-600" aria-label="Campaign actions">
        <a href="#email" class="bg-[var(--color-track-blue)] px-3 py-2 text-white">1 · Email</a>
        <a href="#petition" class="bg-[var(--color-grey-100)] px-3 py-2 text-[var(--color-track-blue)]">2 · Sign</a>
        <a href="#share" class="bg-[var(--color-grey-100)] px-3 py-2 text-[var(--color-track-blue)]">3 · Share</a>
      </nav>
    </div>
  </section>

  <!-- Situation -->
  <section class="bg-[var(--color-paper)] py-[clamp(3rem,7vw,5rem)]">
    <div class="mx-auto grid max-w-[var(--container-content)] gap-10 px-6 lg:grid-cols-[3fr_2fr] lg:px-8">
      <div>
        <p class={eyebrow}>What’s happening</p>
        <h2 class={h2}>The council’s own assessment says who loses most.</h2>
        <div class="mt-6 space-y-4 font-body text-lg leading-[1.65] text-[var(--color-grey-700)]">
          {context.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-8 border-l-4 border-[var(--color-track-orange)] bg-white p-6">
          <p class="font-body text-sm font-600 uppercase tracking-[0.05em] text-[var(--color-grey-500)]">Our ask</p>
          <p class="mt-2 font-body text-base leading-[1.6] text-[var(--color-grey-900)]">
            Keep the indoor track available until Brent Council has agreed in writing, with Track Academy and Queen’s Park Harriers, a funded year-round alternative that:
          </p>
          <ol class="mt-3 list-decimal space-y-1 pl-5 font-body text-base leading-[1.6] text-[var(--color-grey-700)]">
            {asks.map((a) => <li>{a}</li>)}
          </ol>
        </div>
      </div>
      <dl class="grid grid-cols-2 content-start gap-4">
        {facts.map((f) => (
          <div class="bg-[var(--color-track-blue)] p-5 text-white">
            <dt class="sr-only">{f.label}</dt>
            <dd class="font-heading text-[clamp(2rem,4vw,3rem)] font-600 leading-none tabular-nums">{f.number}</dd>
            <dd class="mt-2 font-body text-sm leading-[1.4] text-white/80">{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 1. Email councillors -->
  <section id="email" class="scroll-mt-20 bg-white py-[clamp(3rem,7vw,5rem)]">
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 lg:px-8">
      <p class={eyebrow}>Step 1 · 2 minutes</p>
      <h2 class={h2}>Email the councillors responsible</h2>
      <p class="mt-4 max-w-2xl font-body text-lg leading-[1.6] text-[var(--color-grey-700)]">
        Your email goes to {primaryTargets.map((t) => t.name).join(' and ')}. If you live in Brent, we’ll also copy in your own ward councillors. They have to listen to residents in their ward.
      </p>

      <form id="email-form" class="mt-8 grid gap-5 sm:grid-cols-2" novalidate>
        <div>
          <label class={labelCls} for="em-name">Your name</label>
          <input class={input} id="em-name" name="name" autocomplete="name" required maxlength="120" />
        </div>
        <div>
          <label class={labelCls} for="em-postcode">Your postcode</label>
          <input class={input} id="em-postcode" name="postcode" autocomplete="postal-code" required maxlength="10" />
          <p class="mt-1 font-body text-xs text-[var(--color-grey-500)]" data-ward-note aria-live="polite"></p>
        </div>
        <div class="sm:col-span-2">
          <label class={labelCls} for="em-rel">I am a…</label>
          <select class={input} id="em-rel" name="relationship">
            {relationships.map((r) => <option value={r.value}>{r.label}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class={labelCls} for="em-personal">Add one line about what Track Academy means to you or your family</label>
          <textarea class={input} id="em-personal" name="personal" rows="3" maxlength="600" placeholder="e.g. My daughter started at 11. The winter sessions are the only time she trains with her friends."></textarea>
          <p class="mt-1 font-body text-xs text-[var(--color-grey-500)]">Personal emails get read. Identical ones get filtered.</p>
        </div>
      </form>

      <div class="mt-8 border border-[var(--color-grey-300)] bg-[var(--color-grey-50)]">
        <div class="border-b border-[var(--color-grey-300)] px-5 py-3 font-body text-sm text-[var(--color-grey-700)]">
          <p><span class="font-600">To:</span> <span data-to></span></p>
          <p data-cc-row hidden><span class="font-600">Cc:</span> <span data-cc></span></p>
          <p><span class="font-600">Subject:</span> <span data-subject></span></p>
        </div>
        <pre class="max-h-[28rem] overflow-auto whitespace-pre-wrap px-5 py-4 font-body text-[0.95rem] leading-[1.6] text-[var(--color-grey-900)]" data-body></pre>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#" class={btn} data-send="mailto">Open in my email app</a>
        <a href="#" class={btnGhost} data-send="gmail" target="_blank" rel="noopener">Gmail</a>
        <a href="#" class={btnGhost} data-send="outlook" target="_blank" rel="noopener">Outlook</a>
        <button type="button" class={btnGhost} data-send="copy">Copy email</button>
      </div>
      <p class="mt-3 font-body text-xs text-[var(--color-grey-500)]" data-copy-note aria-live="polite">Copying? Paste the addresses above into a new email.</p>

      <div class="mt-8 hidden bg-[var(--color-grey-100)] p-6" data-confirm-sent>
        <p class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Did you press send?</p>
        <p class="mt-2 font-body text-[var(--color-grey-700)]">Tell us so we can show the council how many people wrote.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <button type="button" class={btn} data-sent-yes>Yes, I sent it</button>
          <button type="button" class={btnGhost} data-sent-no>Not yet</button>
        </div>
      </div>
      <div class="mt-8 hidden bg-[var(--color-track-blue)] p-6 text-white" data-sent-thanks>
        <p class="font-heading text-xl font-500">Thank you. Now add your name to the petition.</p>
        <a href="#petition" class="mt-4 inline-block font-body font-600 text-[var(--color-track-gold)] underline">Go to step 2 →</a>
      </div>
    </div>
  </section>

  <!-- 2. Petition -->
  <section id="petition" class="scroll-mt-20 tracked-surface bg-[var(--color-track-navy)] py-[clamp(3rem,7vw,5rem)] text-white">
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 lg:px-8">
      <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[0.05em] text-[var(--color-track-gold)]">Step 2 · 30 seconds</p>
      <h2 class="font-heading text-[clamp(1.5rem,4vw,2.5rem)] font-500 leading-[1.1]">Sign the petition</h2>
      <p class="mt-4 max-w-2xl font-body text-lg leading-[1.6] text-white/80">
        Brent Council should keep the indoor track at Willesden Sports Centre available until it has agreed in writing a funded, year-round indoor athletics alternative with Track Academy and Queen’s Park Harriers, including Saturday provision.
      </p>
      <div class="mt-6" data-petition-progress hidden>
        <div class="h-3 w-full bg-white/15"><div class="h-3 bg-[var(--color-track-orange)] transition-all duration-700" style="width:0%" data-progress-bar></div></div>
        <p class="mt-2 font-body text-sm text-white/80"><strong class="tabular-nums text-white" data-stat="petition">0</strong> of {campaign.petitionTarget.toLocaleString('en-GB')} signatures · <span data-stat="wards_reached">0</span> Brent wards</p>
      </div>

      <form id="petition-form" class="mt-8 grid gap-5 sm:grid-cols-2" novalidate>
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <div>
          <label class="mb-2 block font-body text-sm font-600" for="pt-name">Full name</label>
          <input class={input} id="pt-name" name="full_name" autocomplete="name" required maxlength="120" />
        </div>
        <div>
          <label class="mb-2 block font-body text-sm font-600" for="pt-email">Email</label>
          <input class={input} id="pt-email" name="email" type="email" autocomplete="email" required maxlength="200" />
        </div>
        <div>
          <label class="mb-2 block font-body text-sm font-600" for="pt-postcode">Postcode</label>
          <input class={input} id="pt-postcode" name="postcode" autocomplete="postal-code" required maxlength="10" />
        </div>
        <div>
          <label class="mb-2 block font-body text-sm font-600" for="pt-rel">I am a…</label>
          <select class={input} id="pt-rel" name="relationship">
            {relationships.map((r) => <option value={r.value}>{r.label}</option>)}
          </select>
        </div>
        <label class="flex gap-3 font-body text-sm leading-[1.5] text-white/90 sm:col-span-2">
          <input type="checkbox" name="consent_council" required class="mt-1 h-4 w-4 shrink-0" />
          <span>I agree that my name and postcode can be given to Brent Council as part of this petition. (Required.)</span>
        </label>
        <label class="flex gap-3 font-body text-sm leading-[1.5] text-white/90 sm:col-span-2">
          <input type="checkbox" name="consent_updates" class="mt-1 h-4 w-4 shrink-0" />
          <span>Email me campaign updates from Track Academy. You can unsubscribe at any time.</span>
        </label>
        <div class="sm:col-span-2">
          <button type="submit" class={btn}>Sign the petition</button>
          <p class="mt-3 font-body text-sm text-[var(--color-track-gold)]" data-form-msg aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <!-- 3. Share -->
  <section id="share" class="scroll-mt-20 bg-[var(--color-paper)] py-[clamp(3rem,7vw,5rem)]">
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 lg:px-8">
      <p class={eyebrow}>Step 3 · 10 seconds</p>
      <h2 class={h2}>Send this to three people</h2>
      <p class="mt-4 max-w-2xl font-body text-lg leading-[1.6] text-[var(--color-grey-700)]">One parent WhatsApp group can bring in more voices than a week of posts.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#" class={btn} data-share="whatsapp" target="_blank" rel="noopener">Share on WhatsApp</a>
        <button type="button" class={btnGhost} data-share="native" hidden>Share…</button>
        <button type="button" class={btnGhost} data-share="copy">Copy link</button>
        <a href="#" class={btnGhost} data-share="x" target="_blank" rel="noopener">X</a>
        <a href="#" class={btnGhost} data-share="facebook" target="_blank" rel="noopener">Facebook</a>
      </div>
      <p class="mt-3 font-body text-sm text-[var(--color-grey-500)]" data-share-msg aria-live="polite">Use {campaign.hashtag}</p>
    </div>
  </section>

  <!-- Stories wall (approved only) -->
  <section class="hidden bg-white py-[clamp(3rem,7vw,5rem)]" data-stories-wall>
    <div class="mx-auto max-w-[var(--container-content)] px-6 lg:px-8">
      <p class={eyebrow}>In their words</p>
      <h2 class={h2}>What the track means</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3" data-stories></div>
    </div>
  </section>

  <!-- Go further: story + skills -->
  <section class="bg-[var(--color-grey-100)] py-[clamp(3rem,7vw,5rem)]">
    <div class="mx-auto grid max-w-[var(--container-content)] gap-8 px-6 lg:grid-cols-2 lg:px-8">
      <div id="story" class="scroll-mt-20 bg-white p-7 lg:p-9">
        <p class={eyebrow}>Go further</p>
        <h2 class="font-heading text-[clamp(1.35rem,3vw,1.9rem)] font-500 leading-[1.1] text-[var(--color-track-blue)]">Share your story</h2>
        <p class="mt-3 font-body text-[var(--color-grey-700)]">Stories go into our evidence for the council and, with permission, onto this page. Our safeguarding lead checks every story first.</p>
        <form id="story-form" class="mt-6 grid gap-4" novalidate>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class={labelCls} for="st-name">First name (as shown)</label>
              <input class={input} id="st-name" name="display_name" required maxlength="60" />
            </div>
            <div>
              <label class={labelCls} for="st-age">Age of the person the story is about</label>
              <select class={input} id="st-age" name="age_band">
                <option value="18_plus">18 or over</option>
                <option value="13_17">13–17</option>
                <option value="under_13">Under 13</option>
              </select>
            </div>
          </div>
          <div>
            <label class={labelCls} for="st-rel">I am a…</label>
            <select class={input} id="st-rel" name="relationship">
              {relationships.map((r) => <option value={r.value}>{r.label}</option>)}
            </select>
          </div>
          <div>
            <label class={labelCls} for="st-story">Your story</label>
            <textarea class={input} id="st-story" name="story" rows="5" required minlength="20" maxlength="3000"></textarea>
          </div>
          <div>
            <label class={labelCls} for="st-email">Email (optional, so we can check details)</label>
            <input class={input} id="st-email" name="contact_email" type="email" maxlength="200" />
          </div>
          <label class="flex gap-3 font-body text-sm text-[var(--color-grey-700)]" data-parent-consent hidden>
            <input type="checkbox" name="parent_consent" class="mt-1 h-4 w-4 shrink-0" />
            <span>I am the parent or carer of this young person and I give consent for this story to be shared.</span>
          </label>
          <label class="flex gap-3 font-body text-sm text-[var(--color-grey-700)]">
            <input type="checkbox" name="consent_publish" class="mt-1 h-4 w-4 shrink-0" />
            <span>Track Academy may publish this story (first name only) on this page and share it with the council.</span>
          </label>
          <label class="flex gap-3 font-body text-sm text-[var(--color-grey-700)]">
            <input type="checkbox" name="media_ok" class="mt-1 h-4 w-4 shrink-0" />
            <span>I’m happy for Track Academy to ask me about speaking to the press.</span>
          </label>
          <button type="submit" class={btn}>Send my story</button>
          <p class="font-body text-sm text-[var(--color-track-blue)]" data-form-msg aria-live="polite"></p>
        </form>
      </div>

      <div id="skills" class="scroll-mt-20 bg-white p-7 lg:p-9">
        <p class={eyebrow}>Go further</p>
        <h2 class="font-heading text-[clamp(1.35rem,3vw,1.9rem)] font-500 leading-[1.1] text-[var(--color-track-blue)]">Offer your skills or contacts</h2>
        <p class="mt-3 font-body text-[var(--color-grey-700)]">Lawyers, journalists, organisers, people who know councillors. One right contact can change this.</p>
        <form id="skills-form" class="mt-6 grid gap-4" novalidate>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class={labelCls} for="sk-name">Name</label>
              <input class={input} id="sk-name" name="full_name" autocomplete="name" required maxlength="120" />
            </div>
            <div>
              <label class={labelCls} for="sk-email">Email</label>
              <input class={input} id="sk-email" name="email" type="email" autocomplete="email" required maxlength="200" />
            </div>
          </div>
          <div>
            <label class={labelCls} for="sk-phone">Phone (optional)</label>
            <input class={input} id="sk-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
          </div>
          <fieldset>
            <legend class={labelCls}>I can help with</legend>
            <div class="grid gap-2 sm:grid-cols-2">
              {skillOptions.map((s) => (
                <label class="flex gap-2 font-body text-sm text-[var(--color-grey-700)]">
                  <input type="checkbox" name="skills" value={s.value} class="mt-0.5 h-4 w-4" /> {s.label}
                </label>
              ))}
            </div>
          </fieldset>
          <div>
            <label class={labelCls} for="sk-details">Tell us more</label>
            <textarea class={input} id="sk-details" name="details" rows="3" maxlength="2000"></textarea>
          </div>
          <button type="submit" class={btn}>Offer help</button>
          <p class="font-body text-sm text-[var(--color-track-blue)]" data-form-msg aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <!-- Membership survey (opens on campaign.surveyOpensOn) -->
  <section id="survey" class="hidden scroll-mt-20 bg-white py-[clamp(3rem,7vw,5rem)]" data-survey>
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 lg:px-8">
      <p class={eyebrow}>Anonymous · 1 minute</p>
      <h2 class={h2}>Willesden Sports Centre membership survey</h2>
      <p class="mt-4 max-w-2xl font-body text-lg leading-[1.6] text-[var(--color-grey-700)]">The council’s plan is built on gym membership numbers. Help us check whether it has counted families like yours. We don’t ask for your name or email.</p>
      <form id="survey-form" class="mt-8 grid gap-6" novalidate>
        <fieldset>
          <legend class={labelCls}>Do you or your family hold a Willesden Sports Centre membership?</legend>
          <div class="flex gap-6 font-body">
            <label class="flex items-center gap-2"><input type="radio" name="is_member" value="yes" required /> Yes</label>
            <label class="flex items-center gap-2"><input type="radio" name="is_member" value="no" /> No</label>
          </div>
        </fieldset>

        <div class="hidden grid gap-6" data-branch="member">
          <div class="grid gap-4 sm:grid-cols-3">
            <div>
              <label class={labelCls} for="sv-type">Membership type</label>
              <select class={input} id="sv-type" name="membership_type">
                <option value="individual">Individual</option>
                <option value="family">Family</option>
                <option value="junior">Junior</option>
                <option value="concession">Concession</option>
                <option value="pay_as_you_go">Pay as you go</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label class={labelCls} for="sv-count">People in your household with a membership</label>
              <input class={input} id="sv-count" name="members_in_household" type="number" min="1" max="12" value="1" />
            </div>
            <div>
              <label class={labelCls} for="sv-spend">Roughly what your household pays per month</label>
              <select class={input} id="sv-spend" name="monthly_spend_band">
                <option value="under_20">Under £20</option>
                <option value="20_39">£20–£39</option>
                <option value="40_59">£40–£59</option>
                <option value="60_99">£60–£99</option>
                <option value="100_plus">£100+</option>
                <option value="not_sure">Not sure</option>
              </select>
            </div>
          </div>
          <fieldset>
            <legend class={labelCls}>If the indoor track is removed, would you consider cancelling your membership?</legend>
            <div class="flex gap-6 font-body">
              <label class="flex items-center gap-2"><input type="radio" name="would_consider_cancelling" value="yes" /> Yes</label>
              <label class="flex items-center gap-2"><input type="radio" name="would_consider_cancelling" value="maybe" /> Maybe</label>
              <label class="flex items-center gap-2"><input type="radio" name="would_consider_cancelling" value="no" /> No</label>
            </div>
          </fieldset>
        </div>

        <div class="hidden" data-branch="non-member">
          <fieldset>
            <legend class={labelCls}>If the indoor track were kept and the facilities improved, would you consider getting a membership?</legend>
            <div class="flex gap-6 font-body">
              <label class="flex items-center gap-2"><input type="radio" name="would_consider_joining" value="yes" /> Yes</label>
              <label class="flex items-center gap-2"><input type="radio" name="would_consider_joining" value="maybe" /> Maybe</label>
              <label class="flex items-center gap-2"><input type="radio" name="would_consider_joining" value="no" /> No</label>
            </div>
          </fieldset>
        </div>

        <label class="flex gap-3 font-body text-sm text-[var(--color-grey-700)]">
          <input type="checkbox" name="uses_centre_during_sessions" class="mt-1 h-4 w-4 shrink-0" />
          <span>I use the centre (gym, pool, café) while my child is at Track Academy.</span>
        </label>
        <div class="grid gap-4 sm:grid-cols-[1fr_3fr]">
          <div>
            <label class={labelCls} for="sv-pc">First half of postcode (optional)</label>
            <input class={input} id="sv-pc" name="postcode_district" maxlength="4" placeholder="NW10" />
          </div>
          <div>
            <label class={labelCls} for="sv-comment">Anything you’d like to add? (optional)</label>
            <input class={input} id="sv-comment" name="comment" maxlength="1500" />
          </div>
        </div>
        <div>
          <button type="submit" class={btn}>Submit</button>
          <p class="mt-3 font-body text-sm text-[var(--color-track-blue)]" data-form-msg aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <!-- Small print -->
  <section class="bg-[var(--color-grey-100)] py-10">
    <div class="mx-auto max-w-[var(--container-narrow)] space-y-3 px-6 font-body text-sm leading-[1.6] text-[var(--color-grey-500)] lg:px-8">
      <p>Track Academy is a registered charity (1164222). This campaign is about a facility for young people. It is not party political, and we are asking councillors from every party for support.</p>
      <p>How we use your information: petition names and postcodes are given to Brent Council. Emails to councillors are sent from your own email account. Ward lookups use postcodes.io. The membership survey is anonymous. We delete campaign data six months after the campaign ends. See our <a class="underline" href="/privacy">privacy policy</a>.</p>
      <p>Questions? Email <a class="underline" href={`mailto:${campaign.contactEmail}`}>{campaign.contactEmail}</a>.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import { campaign, primaryTargets, wardCouncillors, emailOpeners, emailSubjects, emailBody } from '../../data/campaign';
  import { insert, rpc, getRef, getSessionId, lookupPostcode, supabaseReady, type PostcodeInfo } from '../../lib/campaign-client';

  const ref = getRef();
  const sid = getSessionId();
  const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => [...root.querySelectorAll<T>(s)];
  const pageUrl = `${location.origin}${campaign.slug}`;

  /** Clipboard with a fallback for older phones and in-app browsers (e.g. Instagram, WhatsApp). */
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;opacity:0';
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    }
  }

  // ---------- Live numbers ----------
  type Stats = { petition: number; emails_sent: number; wards_reached: number; stories: { display_name: string; relationship: string; story: string }[] };
  async function loadStats() {
    if (!supabaseReady) return;
    try {
      const s = await rpc<Stats>('campaign_public_stats');
      if (!s) return;
      for (const el of $$('[data-stat]')) {
        const k = el.dataset.stat as keyof Stats;
        el.textContent = Number(s[k] ?? 0).toLocaleString('en-GB');
      }
      if (s.petition + s.emails_sent >= 25) $('[data-live-counter]').hidden = false; // hide tiny numbers
      if (s.petition >= 25) {
        $('[data-petition-progress]').hidden = false;
        $('[data-progress-bar]').style.width = `${Math.min(100, (s.petition / campaign.petitionTarget) * 100)}%`;
      }
      if (s.stories?.length) {
        const wrap = $('[data-stories]');
        wrap.replaceChildren(
          ...s.stories.map((st) => {
            const card = document.createElement('blockquote');
            card.className = 'bg-[var(--color-grey-100)] p-6 font-body text-[var(--color-grey-900)]';
            const p = document.createElement('p');
            p.className = 'leading-[1.6]';
            p.textContent = `“${st.story}”`;
            const c = document.createElement('footer');
            c.className = 'mt-4 text-sm font-600 text-[var(--color-track-blue)]';
            c.textContent = `— ${st.display_name}`;
            card.append(p, c);
            return card;
          }),
        );
        $('[data-stories-wall]').classList.remove('hidden');
      }
    } catch { /* numbers are a bonus */ }
  }
  loadStats();

  // ---------- Email builder ----------
  const form = $<HTMLFormElement>('#email-form');
  const norm = (w: string) => w.toLowerCase().replace(/&/g, 'and').replace(/[^a-z]/g, '');
  const wardIndex = new Map(Object.entries(wardCouncillors).map(([w, list]) => [norm(w), list]));
  let pc: PostcodeInfo | null = null;
  const subject = emailSubjects[Math.floor(Math.random() * emailSubjects.length)];

  function recipients() {
    const to = primaryTargets.map((t) => t.email);
    const cc = pc?.inBrent && pc.ward
      ? (wardIndex.get(norm(pc.ward)) ?? []).map((c) => c.email).filter((e) => !to.some((t) => t.toLowerCase() === e.toLowerCase()))
      : [];
    return { to, cc };
  }

  function current() {
    const fd = new FormData(form);
    const rel = String(fd.get('relationship') || 'other');
    const body = emailBody({
      opener: emailOpeners[rel] ?? emailOpeners.other,
      place: pc ? (pc.inBrent && pc.ward ? `${pc.ward} ward, ${pc.postcode}` : pc.postcode) : '',
      personal: String(fd.get('personal') || '').trim(),
      name: String(fd.get('name') || '').trim(),
      postcode: pc?.postcode ?? String(fd.get('postcode') || '').trim().toUpperCase(),
    });
    return { rel, body, ...recipients() };
  }

  function render() {
    const { body, to, cc } = current();
    $('[data-to]').textContent = to.join(', ');
    $('[data-cc]').textContent = cc.join(', ');
    $('[data-cc-row]').hidden = cc.length === 0;
    $('[data-subject]').textContent = subject;
    $('[data-body]').textContent = body;
  }

  let pcTimer: number | undefined;
  $('#em-postcode').addEventListener('input', (e) => {
    clearTimeout(pcTimer);
    const v = (e.target as HTMLInputElement).value;
    pcTimer = window.setTimeout(async () => {
      pc = await lookupPostcode(v);
      const note = $('[data-ward-note]');
      if (!pc) note.textContent = v.trim().length >= 5 ? 'We couldn’t find that postcode. You can still send.' : '';
      else if (pc.inBrent && pc.ward) {
        const n = wardIndex.get(norm(pc.ward))?.length ?? 0;
        note.textContent = `${pc.ward} ward. We’ve added your ${n} ward councillor${n === 1 ? '' : 's'}.`;
      } else note.textContent = `Outside Brent (${pc.district ?? 'unknown'}). Your email still counts.`;
      render();
    }, 400);
  });
  form.addEventListener('input', render);
  render();

  function logEmail(action: 'email_opened' | 'email_sent', method: string) {
    const { rel, to, cc } = current();
    insert('campaign_actions', {
      action, method, ref, session_id: sid, relationship: rel,
      ward: pc?.inBrent ? pc.ward : null, in_brent: pc?.inBrent ?? null, recipients: to.length + cc.length,
    });
  }

  let lastMethod = 'mailto';
  for (const el of $$('[data-send]')) {
    el.addEventListener('click', async (e) => {
      const method = el.dataset.send!;
      if (!String(new FormData(form).get('name') || '').trim()) {
        e.preventDefault();
        $('#em-name').focus();
        $('[data-copy-note]').textContent = 'Add your name first. Councillors ignore unsigned emails.';
        return;
      }
      const { body, to, cc } = current();
      const bcc = campaign.bccInbox ? [campaign.bccInbox] : [];
      const enc = encodeURIComponent;
      if (method === 'mailto') {
        (el as HTMLAnchorElement).href =
          `mailto:${to.join(',')}?subject=${enc(subject)}&body=${enc(body)}` +
          (cc.length ? `&cc=${cc.join(',')}` : '') + (bcc.length ? `&bcc=${bcc.join(',')}` : '');
      } else if (method === 'gmail') {
        (el as HTMLAnchorElement).href =
          `https://mail.google.com/mail/?view=cm&fs=1&to=${enc(to.join(','))}&cc=${enc(cc.join(','))}&bcc=${enc(bcc.join(','))}&su=${enc(subject)}&body=${enc(body)}`;
      } else if (method === 'outlook') {
        (el as HTMLAnchorElement).href =
          `https://outlook.live.com/mail/0/deeplink/compose?to=${enc(to.join(';'))}&cc=${enc(cc.join(';'))}&bcc=${enc(bcc.join(';'))}&subject=${enc(subject)}&body=${enc(body)}`;
      }
      lastMethod = method;
      logEmail('email_opened', method);
      setTimeout(() => $('[data-confirm-sent]').classList.remove('hidden'), 1500);
      if (method === 'copy') {
        const ok = await copyText(`To: ${to.join(', ')}${cc.length ? `\nCc: ${cc.join(', ')}` : ''}\nSubject: ${subject}\n\n${body}`);
        $('[data-copy-note]').textContent = ok
          ? 'Copied. Paste into a new email, then send.'
          : 'Couldn’t copy automatically. Select the email text above and copy it.';
      }
    });
  }
  $('[data-sent-yes]').addEventListener('click', () => {
    logEmail('email_sent', lastMethod);
    $('[data-confirm-sent]').classList.add('hidden');
    $('[data-sent-thanks]').classList.remove('hidden');
    // Carry details into the petition form.
    const fd = new FormData(form);
    ($('#pt-name') as HTMLInputElement).value ||= String(fd.get('name') || '');
    ($('#pt-postcode') as HTMLInputElement).value ||= pc?.postcode ?? String(fd.get('postcode') || '');
    ($('#pt-rel') as HTMLSelectElement).value = String(fd.get('relationship') || 'other');
  });
  $('[data-sent-no]').addEventListener('click', () => $('[data-confirm-sent]').classList.add('hidden'));

  // ---------- Generic form helper ----------
  function wire(id: string, handler: (fd: FormData, f: HTMLFormElement) => Promise<string | null>) {
    const f = $<HTMLFormElement>(id);
    const msg = $('[data-form-msg]', f);
    const btn = $<HTMLButtonElement>('button[type=submit]', f);
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(f);
      if (fd.get('website')) return; // bot honeypot
      if (!f.checkValidity()) { f.reportValidity(); return; }
      btn.disabled = true;
      msg.textContent = 'Sending…';
      const err = await handler(fd, f);
      btn.disabled = false;
      msg.textContent = err ?? '';
    });
    return f;
  }
  const offline = 'We couldn’t save this just now. Please try again, or email ' + campaign.contactEmail + '.';

  // Petition
  wire('#petition-form', async (fd, f) => {
    const info = await lookupPostcode(String(fd.get('postcode')));
    const r = await insert('petition_signatures', {
      full_name: String(fd.get('full_name')).trim(),
      email: String(fd.get('email')).trim().toLowerCase(),
      postcode: info?.postcode ?? String(fd.get('postcode')).trim().toUpperCase(),
      ward: info?.inBrent ? info.ward : null,
      in_brent: info?.inBrent ?? null,
      relationship: fd.get('relationship'),
      consent_council: fd.get('consent_council') === 'on',
      consent_updates: fd.get('consent_updates') === 'on',
      ref,
    });
    if (r.ok || r.duplicate) {
      f.innerHTML = `<p class="font-heading text-2xl text-white">${r.duplicate ? 'You’ve already signed. Thank you.' : 'Signed. Thank you.'}</p>
        <p class="mt-3 font-body text-white/80">Last step: send this to three people.</p>
        <a href="#share" class="mt-4 inline-block font-body font-600 text-[var(--color-track-gold)] underline">Share now →</a>`;
      loadStats();
      return null;
    }
    return offline;
  });

  // Story
  const ageSel = $<HTMLSelectElement>('#st-age');
  const parentBox = $('[data-parent-consent]');
  ageSel.addEventListener('change', () => {
    const child = ageSel.value !== '18_plus';
    parentBox.hidden = !child;
    $<HTMLInputElement>('input', parentBox).required = child;
  });
  wire('#story-form', async (fd, f) => {
    const r = await insert('campaign_stories', {
      display_name: String(fd.get('display_name')).trim().split(' ')[0],
      relationship: fd.get('relationship'),
      age_band: fd.get('age_band'),
      story: String(fd.get('story')).trim(),
      contact_email: String(fd.get('contact_email') || '').trim() || null,
      consent_publish: fd.get('consent_publish') === 'on',
      parent_consent: fd.get('parent_consent') === 'on',
      media_ok: fd.get('media_ok') === 'on',
      ref,
    });
    if (r.ok) { f.innerHTML = '<p class="font-heading text-xl text-[var(--color-track-blue)]">Thank you. We’ll check your story and be in touch if we need anything.</p>'; return null; }
    return offline;
  });

  // Skills
  wire('#skills-form', async (fd, f) => {
    const r = await insert('campaign_offers', {
      full_name: String(fd.get('full_name')).trim(),
      email: String(fd.get('email')).trim().toLowerCase(),
      phone: String(fd.get('phone') || '').trim() || null,
      skills: fd.getAll('skills'),
      details: String(fd.get('details') || '').trim() || null,
      ref,
    });
    if (r.ok) { f.innerHTML = '<p class="font-heading text-xl text-[var(--color-track-blue)]">Thank you. Someone from the campaign team will contact you.</p>'; return null; }
    return offline;
  });

  // Survey (date-gated)
  const surveyOpen = new Date() >= new Date(`${campaign.surveyOpensOn}T00:00:00`) || new URLSearchParams(location.search).has('survey');
  if (surveyOpen) $('[data-survey]').classList.remove('hidden');
  const sForm = $<HTMLFormElement>('#survey-form');
  for (const r of $$<HTMLInputElement>('input[name=is_member]', sForm)) {
    r.addEventListener('change', () => {
      const member = r.value === 'yes' && r.checked;
      $('[data-branch=member]', sForm).classList.toggle('hidden', !member);
      $('[data-branch=non-member]', sForm).classList.toggle('hidden', member);
    });
  }
  wire('#survey-form', async (fd, f) => {
    try { if (localStorage.getItem('ptt_survey_done')) return 'You’ve already answered on this device. Thank you.'; } catch {}
    const isMember = fd.get('is_member') === 'yes';
    const answer = isMember ? fd.get('would_consider_cancelling') : fd.get('would_consider_joining');
    if (!answer) return 'Please answer the second question.';
    const r = await insert('membership_survey', {
      is_member: isMember,
      membership_type: isMember ? fd.get('membership_type') : null,
      members_in_household: isMember ? Number(fd.get('members_in_household') || 1) : null,
      monthly_spend_band: isMember ? fd.get('monthly_spend_band') : null,
      would_consider_cancelling: isMember ? answer : null,
      would_consider_joining: isMember ? null : answer,
      uses_centre_during_sessions: fd.get('uses_centre_during_sessions') === 'on',
      postcode_district: String(fd.get('postcode_district') || '').trim().toUpperCase().slice(0, 4) || null,
      comment: String(fd.get('comment') || '').trim() || null,
      ref, session_id: sid,
    });
    if (r.ok) {
      try { localStorage.setItem('ptt_survey_done', '1'); } catch {}
      f.innerHTML = '<p class="font-heading text-xl text-[var(--color-track-blue)]">Thank you. Your answer has been recorded anonymously.</p>';
      return null;
    }
    return offline;
  });

  // ---------- Share ----------
  const shareUrl = `${pageUrl}?ref=share`;
  const text = `${campaign.shareText} ${shareUrl}`;
  const enc = encodeURIComponent;
  const wa = $<HTMLAnchorElement>('[data-share=whatsapp]');
  wa.href = `https://wa.me/?text=${enc(text)}`;
  $<HTMLAnchorElement>('[data-share=x]').href = `https://twitter.com/intent/tweet?text=${enc(`${campaign.shareText} ${campaign.hashtag}`)}&url=${enc(shareUrl)}`;
  $<HTMLAnchorElement>('[data-share=facebook]').href = `https://www.facebook.com/sharer/sharer.php?u=${enc(shareUrl)}`;
  const nativeBtn = $<HTMLButtonElement>('[data-share=native]');
  if (navigator.share) nativeBtn.hidden = false;
  for (const el of $$('[data-share]')) {
    el.addEventListener('click', async () => {
      const kind = el.dataset.share!;
      if (kind === 'copy') {
        $('[data-share-msg]').textContent = (await copyText(shareUrl)) ? 'Link copied.' : shareUrl;
      }
      if (kind === 'native') {
        try { await navigator.share({ title: campaign.headline, text: campaign.shareText, url: shareUrl }); } catch { return; }
      }
      insert('campaign_actions', { action: `share_${kind}`, ref, session_id: sid });
    });
  }
</script>
