---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackEntranceHero from '../components/sections/TrackEntranceHero.astro';
import AudienceRouter from '../components/sections/AudienceRouter.astro';
import ProgrammeEditorial from '../components/sections/ProgrammeEditorial.astro';
import VideoEmbed from '../components/sections/VideoEmbed.astro';
import NumeralsEscaping from '../components/sections/NumeralsEscaping.astro';
import AthleteStack from '../components/sections/AthleteStack.astro';
import InstagramFeed from '../components/sections/InstagramFeed.astro';
import SchoolsTeaser from '../components/sections/SchoolsTeaser.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import FinalDecision from '../components/sections/FinalDecision.astro';
import { latestReportedYoungPeople } from '../data/impact';

const seo = {
  title: 'Track Academy — Athletics, Education & Mentoring in Brent',
  description:
    'Athletics, education and mentoring for young people aged 5–23 in Brent. £25 per term, with free places available through financial support.',
};
---

<BaseLayout {...seo}>
  <TrackEntranceHero
    headline="A place to train. A place to belong."
    lead="Three times a week in Brent, young people come to train, get help with school and find adults who keep showing up."
  />

  <TrustBar />
  <AudienceRouter />
  <VideoEmbed videoId="RVxiOzJPtAc" title="See what the track means to young people." />
  <InstagramFeed />
  <ProgrammeEditorial />
  <NumeralsEscaping
    stats={[
      { number: latestReportedYoungPeople, label: 'young people impacted', context: 'in the past year' },
    ]}
    caption="One place to train, learn and belong."
  />
  <AthleteStack />

  <SchoolsTeaser />
  <TrustStrip />
  <FinalDecision />
</BaseLayout>
