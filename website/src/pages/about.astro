---
/**
 * About page — Track Academy
 * Per art-direction-pro.md: Hero Type B (Editorial Split), Founder's Track (Signature 5), Brent Context (Signature 7)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SimpleHero from '../components/sections/SimpleHero.astro';
import CTABanner from '../components/sections/CTABanner.astro';
import { Image } from 'astro:assets';
import OlderStudents from '../assets/hero/older-students.jpg';
import CoachDemo from '../assets/hero/coach-demonstrating.jpg';

const seo = {
  title: 'About Track Academy — Changing Lives in Brent',
  description: 'Founded in 2007 by Connie Henry MBE, Track Academy blends athletics, education and mentoring in Brent. Meet the team, read our story.',
};
---

<BaseLayout {...seo}>
  <!-- Hero Type B: Editorial Split -->
  <SimpleHero
    image={OlderStudents}
    title="About Track Academy"
    lead="Blending athletics, education and mentoring, Track Academy is a launchpad for young people to break down barriers, unlock their potential and thrive."
  />

  <!-- Vision and mission -->
  <section class="bg-[var(--color-grey-100)] py-[clamp(3rem,8vw,6rem)]" aria-labelledby="vision-mission-heading">
    <div class="mx-auto max-w-[var(--container-content)] px-6 lg:px-8">
      <div class="mb-10 max-w-2xl lg:mb-14">
        <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[-0.05em] text-[var(--color-track-orange)]">Why we exist</p>
        <h2 id="vision-mission-heading" class="font-heading text-[clamp(1.75rem,5vw,3rem)] font-500 leading-[1.05] tracking-[-0.02em] text-[var(--color-track-blue)]">A brighter future is built together.</h2>
      </div>
      <div class="grid gap-px bg-[var(--color-grey-300)] md:grid-cols-2">
        <article class="bg-[var(--color-track-blue)] p-8 text-white lg:p-10">
          <p class="font-body text-sm font-semibold uppercase tracking-[0.08em] text-[var(--color-track-gold)]">Our vision</p>
          <p class="mt-6 max-w-xl font-heading text-[clamp(1.35rem,2.5vw,2rem)] font-400 leading-[1.2]">A world where every young person, regardless of background, has the opportunity, support and belief to achieve their full potential — on the track, in the classroom and in life.</p>
        </article>
        <article class="bg-white p-8 lg:p-10">
          <p class="font-body text-sm font-semibold uppercase tracking-[0.08em] text-[var(--color-track-orange)]">Our mission</p>
          <p class="mt-6 max-w-xl font-heading text-[clamp(1.35rem,2.5vw,2rem)] font-400 leading-[1.2] text-[var(--color-track-blue)]">We blend athletics, education and mentoring to create a launchpad for young people to break down barriers, unlock their potential and thrive.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Founder's Track — Signature Moment 5: pinned image, scrolling text, cross-fade -->
  <section class="bg-[var(--color-paper)] py-[clamp(4rem,10vw,9rem)]">
    <div class="mx-auto max-w-[var(--container-content)] px-6 lg:px-8">
      <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[-0.05em] text-[var(--color-track-orange)]">
        The Founder's Track
      </p>
      <h2 class="mb-[clamp(2rem,5vw,4rem)] max-w-2xl font-heading text-[clamp(1.75rem,5vw,3rem)] font-500 leading-[1.1] tracking-[-0.01em] text-[var(--color-track-blue)]">
        Founded in 2007. One coach. One track.
      </h2>

      <!-- Pinned image + scrolling text -->
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Left: founder image (pinned on desktop) -->
        <div class="lg:sticky lg:top-32 lg:self-start">
          <div class="aspect-[3/4] w-full overflow-hidden">
            <Image
              src={CoachDemo}
              alt="Coach demonstrating at the track"
              class="h-full w-full object-cover"
              loading="lazy"
              widths={[400, 600, 800]}
              sizes="(max-width: 1024px) 100vw, 50vw"
            />
          </div>
          <p class="mt-3 font-body text-sm text-[var(--color-grey-500)]">
            Willesden Sports Centre, NW10.
          </p>
        </div>

        <!-- Right: scrolling story -->
        <div class="space-y-8">
          <div>
            <p class="font-body text-[clamp(1.125rem,1.5vw,1.375rem)] leading-[1.6] text-[var(--color-grey-900)]">
              We empower young people facing challenges to build confidence, resilience and skills — equipping them with the tools to shape their own futures.
            </p>
          </div>
          <div>
            <p class="font-body text-[clamp(1.125rem,1.5vw,1.375rem)] leading-[1.6] text-[var(--color-grey-900)]">
              Track Academy was founded in 2007 by former athlete Connie Henry MBE, who grew up in Brent and trained at Willesden Sports Centre. Connie led the charity until 2024, when she stepped back to pursue other projects. Acutely aware that sport gave her opportunities she may not otherwise have had, she created Track Academy so young people in Brent could fulfil their own potential.
            </p>
          </div>
          <div>
            <p class="font-body text-[clamp(1.125rem,1.5vw,1.375rem)] leading-[1.6] text-[var(--color-grey-900)]">
              For over 17 years, we've been embedded in the Brent community, founded on the belief that athletics is a vehicle for profound social change. We provide a safe, supportive community for young people from some of London's most under-resourced areas.
            </p>
          </div>
          <div>
            <p class="font-body text-[clamp(1.125rem,1.5vw,1.375rem)] leading-[1.6] text-[var(--color-grey-900)]">
              We understand the challenges our young people face: educational inequality, a lack of safe spaces and a mental health crisis. In response, our holistic model blends high-level athletics with academic support, mentoring, life skills, youth enrichment, and holiday and food programmes — all underpinned by trusted adults.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The 360-degree approach -->
  <section class="bg-[var(--color-grey-100)] py-[clamp(3rem,8vw,6rem)]">
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 text-center lg:px-8">
      <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[-0.05em] text-[var(--color-track-orange)]">
        Our Model
      </p>
      <h2 class="mx-auto mb-6 max-w-3xl font-heading text-[clamp(1.5rem,4vw,2.5rem)] font-500 leading-[1.1] tracking-[-0.01em] text-[var(--color-track-blue)]">
        We are more than a sports club.
      </h2>
      <p class="mx-auto max-w-2xl font-body text-base leading-[1.65] text-[var(--color-grey-700)]">
        We are a lifeline, a confidence-builder and a community. We don't just train athletes; we develop positive young people, role models and future leaders.
      </p>

      <div class="mt-12 grid gap-4 text-left sm:grid-cols-2 lg:grid-cols-5">
        <article class="border-t-2 border-[var(--color-track-orange)] pt-4">
          <h3 class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Athletics</h3>
          <p class="mt-2 font-body text-sm leading-[1.6] text-[var(--color-grey-700)]">Training that builds fitness, discipline, teamwork and belief.</p>
        </article>
        <article class="border-t-2 border-[var(--color-track-orange)] pt-4">
          <h3 class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Education</h3>
          <p class="mt-2 font-body text-sm leading-[1.6] text-[var(--color-grey-700)]">Study support and tuition in maths, English and science.</p>
        </article>
        <article class="border-t-2 border-[var(--color-track-orange)] pt-4">
          <h3 class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Mentoring</h3>
          <p class="mt-2 font-body text-sm leading-[1.6] text-[var(--color-grey-700)]">Trusted adult relationships that help young people navigate challenges.</p>
        </article>
        <article class="border-t-2 border-[var(--color-track-orange)] pt-4">
          <h3 class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Life skills</h3>
          <p class="mt-2 font-body text-sm leading-[1.6] text-[var(--color-grey-700)]">Workshops on communication, problem-solving, resilience and teamwork.</p>
        </article>
        <article class="border-t-2 border-[var(--color-track-orange)] pt-4">
          <h3 class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Holiday programmes</h3>
          <p class="mt-2 font-body text-sm leading-[1.6] text-[var(--color-grey-700)]">Activities, enrichment and food when school is closed.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- What makes us different and our values -->
  <section class="bg-[var(--color-paper)] py-[clamp(3rem,8vw,6rem)]" aria-labelledby="values-heading">
    <div class="mx-auto grid max-w-[var(--container-content)] gap-12 px-6 lg:grid-cols-[5fr_7fr] lg:gap-16 lg:px-8">
      <div>
        <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[-0.05em] text-[var(--color-track-orange)]">What makes us different</p>
        <h2 class="font-heading text-[clamp(1.75rem,5vw,3rem)] font-500 leading-[1.05] tracking-[-0.02em] text-[var(--color-track-blue)]">We know what it means to show up.</h2>
        <p class="mt-5 max-w-md font-body text-lg leading-[1.65] text-[var(--color-grey-700)]">Our team reflects the community we serve. Many of our coaches, mentors and trustees are former participants or local residents. We understand the challenges our young people face because we've faced them too.</p>
      </div>
      <div>
        <p id="values-heading" class="mb-5 font-body text-sm font-semibold uppercase tracking-[-0.05em] text-[var(--color-track-orange)]">Our values</p>
        <div class="grid gap-4 sm:grid-cols-2">
          <article class="border-t border-[var(--color-grey-300)] pt-4"><h3 class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Youth-led</h3><p class="mt-2 font-body leading-[1.6] text-[var(--color-grey-700)]">We listen first.</p></article>
          <article class="border-t border-[var(--color-grey-300)] pt-4"><h3 class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Strive for excellence</h3><p class="mt-2 font-body leading-[1.6] text-[var(--color-grey-700)]">We push ourselves and each other.</p></article>
          <article class="border-t border-[var(--color-grey-300)] pt-4"><h3 class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Empathetic</h3><p class="mt-2 font-body leading-[1.6] text-[var(--color-grey-700)]">We lead with kindness and understanding.</p></article>
          <article class="border-t border-[var(--color-grey-300)] pt-4"><h3 class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Committed</h3><p class="mt-2 font-body leading-[1.6] text-[var(--color-grey-700)]">We show up every day.</p></article>
        </div>
      </div>
    </div>
  </section>

  <!-- The Brent Context — Signature Moment 7: one number at a time -->
  <section class="tracked-surface bg-[var(--color-track-navy)] py-[clamp(4rem,10vw,9rem)]">
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 lg:px-8">
      <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[-0.05em] text-[var(--color-track-gold)]">
        The Need
      </p>
      <h2 class="mb-[clamp(2rem,5vw,4rem)] font-heading text-[clamp(1.75rem,5vw,3rem)] font-500 leading-[1.1] tracking-[-0.01em] text-white">
        The need for our work has never been greater.
      </h2>

      <div class="space-y-[clamp(2rem,5vw,3rem)]">
        {[
          { number: '41%', label: 'Brent child poverty' },
          { number: '28%', label: 'feel they have enough safe spaces' },
          { number: '1 in 3', label: 'affected by bullying' },
          { number: '64%', label: 'of girls no longer active by 14' },
        ].map((stat) => (
          <div class="border-b border-white/10 pb-[clamp(1.5rem,3vw,2rem)]">
            <p class="font-heading text-[clamp(4rem,12vw,9rem)] font-300 leading-[0.85] tracking-[-0.03em] text-[var(--color-track-gold)] tabular-nums">
              {stat.number}
            </p>
            <p class="mt-2 font-body text-sm font-medium uppercase tracking-[0.05em] text-white/60">
              {stat.label}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    heading="Help shape what happens next."
    body="We are always looking for exceptional people to help young people go further."
    ctaPrimary={{ label: 'Join the team', href: '/careers' }}
    ctaSecondary={{ label: 'See our impact', href: '/impact' }}
  />
</BaseLayout>
