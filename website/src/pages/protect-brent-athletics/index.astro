---
/**
 * /protect-brent-athletics — Protect Brent Athletics campaign hub.
 * Action ladder: sign (easy) -> email councillors (pre-filled from signing) -> share.
 * Then: story / skills / survey. Details typed once are carried into every later form.
 * Copy lives in src/data/campaign.ts. Data goes to Supabase (see supabase/migrations).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimpleHero from '../../components/sections/SimpleHero.astro';
import { Image } from 'astro:assets';
import HeroImage from '../../assets/hero/indoor-track-willesden.webp';
import GroupPhoto from '../../assets/campaign/group-photo-track.jpg';
import ContactPhoto from '../../assets/team/people/trustees/patrik-ewe.jpg';
import { campaign, context, facts, asks, primaryTargets, relationships, skillOptions } from '../../data/campaign';

const seo = {
  title: 'Protect Brent Athletics | Save the indoor track',
  description:
    'Brent Council is removing the indoor track at Willesden Sports Centre, used by 400+ young people. Sign the petition and email your councillors in two minutes.',
};

const input =
  'w-full border border-[var(--color-grey-300)] bg-white px-4 py-3 font-body text-base text-[var(--color-grey-900)] focus:border-[var(--color-track-blue)] focus:outline-2 focus:outline-offset-0 focus:outline-[var(--color-track-orange)]';
const labelCls = 'mb-2 block font-body text-sm font-600 text-[var(--color-grey-900)]';
const labelDark = 'mb-2 block font-body text-sm font-600 text-white';
const btn =
  'inline-flex items-center justify-center bg-[var(--color-track-orange)] px-6 py-4 font-body text-sm font-semibold uppercase tracking-wide text-white transition-all duration-150 hover:bg-[var(--color-accent-dark)] active:scale-[0.98] disabled:opacity-50';
const btnGhost =
  'inline-flex items-center justify-center border-2 border-[var(--color-track-blue)] px-5 py-3 font-body text-sm font-semibold uppercase tracking-wide text-[var(--color-track-blue)] transition-all duration-150 hover:bg-[var(--color-track-blue)] hover:text-white active:scale-[0.98]';
const linkBtn = 'font-body text-sm font-600 text-[var(--color-track-blue)] underline decoration-[var(--color-track-orange)] decoration-2 underline-offset-4';
const eyebrow = 'mb-3 font-body text-sm font-semibold uppercase tracking-[0.05em] text-[var(--color-track-orange)]';
const h2 = 'font-heading text-[clamp(1.5rem,4vw,2.5rem)] font-500 leading-[1.1] tracking-[-0.01em] text-[var(--color-track-blue)]';
const relOptions = relationships.map((r) => ({ value: r.value, label: r.label }));
---

<BaseLayout {...seo} hideNewsletterPopup hideMobileCta>
  <SimpleHero image={HeroImage} title={campaign.headline} lead="400+ young people train on this track. Sign, then tell your councillors. It takes two minutes." />

  <!-- Progress bar: steps tick off as they're done -->
  <section class="sticky top-20 z-30 border-b lg:top-[88px] border-[var(--color-grey-300)] bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-[var(--container-content)] flex-wrap items-center justify-between gap-3 px-6 py-3 lg:px-8">
      <nav class="flex gap-2 font-body text-sm font-600" aria-label="Campaign steps">
        <a href="#sign" class="bg-[var(--color-track-blue)] px-3 py-2 text-white" data-step-link="sign">1 · Sign</a>
        <a href="#email" class="bg-[var(--color-grey-100)] px-3 py-2 text-[var(--color-track-blue)]" data-step-link="email">2 · Email</a>
        <a href="#share" class="bg-[var(--color-grey-100)] px-3 py-2 text-[var(--color-track-blue)]" data-step-link="share">3 · Share</a>
      </nav>
      <p class="font-body text-sm text-[var(--color-grey-700)]" data-live-counter hidden>
        <strong class="font-heading text-lg text-[var(--color-track-blue)] tabular-nums" data-stat="petition">0</strong> signed ·
        <strong class="font-heading text-lg text-[var(--color-track-blue)] tabular-nums" data-stat="emails_sent">0</strong> emails sent
      </p>
    </div>
  </section>

  <!-- STEP 1 · Sign -->
  <section id="sign" class="scroll-mt-36 tracked-surface bg-[var(--color-track-navy)] py-[clamp(2.5rem,6vw,4.5rem)] text-white">
    <div class="mx-auto grid max-w-[var(--container-content)] gap-10 px-6 lg:grid-cols-[5fr_6fr] lg:px-8">
      <div>
        <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[0.05em] text-[var(--color-track-gold)]">Step 1 of 3 · 30 seconds</p>
        <h2 class="font-heading text-[clamp(1.6rem,4vw,2.6rem)] font-500 leading-[1.08]">Sign the petition</h2>
        <p class="mt-4 font-body text-lg leading-[1.6] text-white/85">
          Keep the indoor track at Willesden Sports Centre open until Brent Council agrees in writing a funded, year-round alternative with Track Academy and Queen’s Park Harriers, including Saturday provision.
        </p>
        <p class="mt-4 hidden font-body text-base leading-[1.6] text-white/70 lg:block">{context[1]}</p>
        <div class="mt-6" data-petition-progress hidden>
          <div class="h-2.5 w-full bg-white/15"><div class="h-2.5 bg-[var(--color-track-orange)] transition-all duration-700" style="width:0%" data-progress-bar></div></div>
          <p class="mt-2 font-body text-sm text-white/80"><strong class="tabular-nums text-white" data-stat="petition">0</strong> of {campaign.petitionTarget.toLocaleString('en-GB')} signatures · <span data-stat="wards_reached">0</span> Brent wards</p>
        </div>
      </div>

      <div>
        <form id="petition-form" class="grid gap-4 sm:grid-cols-2" novalidate>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div class="sm:col-span-2">
            <label class={labelDark} for="pt-name">Full name</label>
            <input class={input} id="pt-name" name="full_name" autocomplete="name" required maxlength="120" data-me="name" />
          </div>
          <div>
            <label class={labelDark} for="pt-email">Email</label>
            <input class={input} id="pt-email" name="email" type="email" inputmode="email" autocomplete="email" required maxlength="200" data-me="email" />
          </div>
          <div>
            <label class={labelDark} for="pt-postcode">Postcode</label>
            <input class={input} id="pt-postcode" name="postcode" autocomplete="postal-code" autocapitalize="characters" required maxlength="10" data-me="postcode" />
            <p class="mt-1 min-h-[1.25rem] font-body text-xs text-white/70" data-ward-note aria-live="polite"></p>
          </div>
          <div class="sm:col-span-2">
            <label class={labelDark} for="pt-rel">I am a…</label>
            <select class={input} id="pt-rel" name="relationship" data-me="relationship">
              {relOptions.map((r) => <option value={r.value}>{r.label}</option>)}
            </select>
          </div>
          <label class="flex gap-3 font-body text-sm leading-[1.5] text-white/90 sm:col-span-2">
            <input type="checkbox" name="consent_council" required class="mt-1 h-4 w-4 shrink-0" />
            <span>My name and postcode can be given to Brent Council with this petition.</span>
          </label>
          <label class="flex gap-3 font-body text-sm leading-[1.5] text-white/90 sm:col-span-2">
            <input type="checkbox" name="consent_updates" class="mt-1 h-4 w-4 shrink-0" />
            <span>Email me campaign updates. Unsubscribe any time.</span>
          </label>
          <div class="sm:col-span-2">
            <button type="submit" class={`${btn} w-full sm:w-auto`}>Add my name</button>
            <p class="mt-3 font-body text-xs text-white/60">Your signature goes to Track Academy’s campaign team, and your name and postcode go to Brent Council with the petition.</p>
            <p class="mt-3 font-body text-sm text-[var(--color-track-gold)]" data-form-msg aria-live="polite"></p>
          </div>
        </form>

        <!-- Shown after signing (or on return visits) -->
        <div class="hidden border-l-4 border-[var(--color-track-orange)] bg-white/10 p-6" data-signed>
          <p class="font-heading text-2xl font-500">✓ <span data-signed-text>You’ve signed.</span></p>
          <p class="mt-2 font-body text-white/80">Signatures count. An email from you counts more. Councillors have to answer their own residents.</p>
          <a href="#email" class={`${btn} mt-5`}>Next: email your councillors</a>
          <button type="button" class="mt-4 block font-body text-xs text-white/60 underline" data-not-me>Not you? Clear my details</button>
        </div>
      </div>
    </div>
  </section>

  <!-- STEP 2 · Email councillors (pre-filled from step 1) -->
  <section id="email" class="scroll-mt-36 bg-white py-[clamp(2.5rem,6vw,4.5rem)]">
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 lg:px-8">
      <p class={eyebrow}>Step 2 of 3 · 1 minute</p>
      <h2 class={h2}>Email your councillors</h2>
      <p class="mt-3 max-w-2xl font-body text-lg leading-[1.6] text-[var(--color-grey-700)]">We’ve written it for you. Add one line of your own and press send.</p>

      <form id="email-form" class="mt-8 grid gap-6" novalidate>
        <!-- Who it's from: summary when we already know them, fields when we don't -->
        <div class="flex flex-wrap items-center justify-between gap-3 bg-[var(--color-grey-100)] px-5 py-4" data-identity-summary hidden>
          <p class="font-body text-[var(--color-grey-900)]"><span class="text-[var(--color-grey-500)]">From</span> <strong data-summary-name></strong> · <span data-summary-place></span></p>
          <button type="button" class={linkBtn} data-identity-edit>Change</button>
        </div>
        <div class="grid gap-4 sm:grid-cols-3" data-identity-fields>
          <div>
            <label class={labelCls} for="em-name">Your name</label>
            <input class={input} id="em-name" name="name" autocomplete="name" required maxlength="120" data-me="name" />
          </div>
          <div>
            <label class={labelCls} for="em-postcode">Postcode</label>
            <input class={input} id="em-postcode" name="postcode" autocomplete="postal-code" autocapitalize="characters" required maxlength="10" data-me="postcode" />
          </div>
          <div>
            <label class={labelCls} for="em-rel">I am a…</label>
            <select class={input} id="em-rel" name="relationship" data-me="relationship">
              {relOptions.map((r) => <option value={r.value}>{r.label}</option>)}
            </select>
          </div>
        </div>

        <div>
          <p class={labelCls}>Going to</p>
          <ul class="flex flex-wrap gap-2" data-recipients aria-live="polite"></ul>
          <p class="mt-2 font-body text-xs text-[var(--color-grey-500)]" data-recipients-note></p>
        </div>

        <div>
          <label class="block font-heading text-[1.2rem] font-500 leading-[1.25] text-[var(--color-track-blue)]" for="em-personal">Tell Brent how Track Academy has helped your child or family</label>
          <p class="mt-1 mb-3 font-body text-sm text-[var(--color-grey-700)]">One or two sentences in your own words. This goes into the middle of your email. Councillors read personal emails and skip copied ones.</p>
          <textarea class={input} id="em-personal" name="personal" rows="3" maxlength="600" placeholder="e.g. My daughter started at 11. Training on the indoor track every winter gave her confidence, friends and a mentor she trusts."></textarea>
          <label class="mt-3 flex gap-3 font-body text-sm leading-[1.5] text-[var(--color-grey-700)]">
            <input type="checkbox" id="em-story-ok" class="mt-1 h-4 w-4 shrink-0" />
            <span>Track Academy can also use this as evidence for the council, and on this page with my first name only. If it’s about my child, I’m their parent or carer. Our safeguarding lead checks everything first.</span>
          </label>
        </div>

        <details class="border border-[var(--color-grey-300)] bg-[var(--color-grey-50)]">
          <summary class="cursor-pointer px-5 py-3 font-body text-sm font-600 text-[var(--color-track-blue)]">Preview the full email · <span class="font-400 text-[var(--color-grey-700)]" data-subject></span></summary>
          <pre class="max-h-[22rem] overflow-auto whitespace-pre-wrap border-t border-[var(--color-grey-300)] px-5 py-4 font-body text-[0.95rem] leading-[1.6] text-[var(--color-grey-900)]" data-body></pre>
        </details>
      </form>

      <p class="mt-6 font-body text-sm text-[var(--color-grey-700)]">This opens your own email with everything filled in. Check it, then press send. It goes from you, straight to the councillors above.</p>
      <div class="mt-3 grid gap-3 sm:flex sm:flex-wrap sm:items-center">
        <a href="#" class={btn} data-send="mailto">Send from my email app</a>
        <a href="#" class={btnGhost} data-send="gmail" target="_blank" rel="noopener">Gmail</a>
        <a href="#" class={btnGhost} data-send="outlook" target="_blank" rel="noopener">Outlook</a>
        <button type="button" class={`${linkBtn} justify-self-start sm:ml-2`} data-send="copy">Copy instead</button>
      </div>
      <p class="mt-3 min-h-[1.25rem] font-body text-sm text-[var(--color-grey-700)]" data-copy-note aria-live="polite"></p>

      <div class="mt-6 hidden bg-[var(--color-grey-100)] p-6" data-confirm-sent>
        <p class="font-heading text-xl font-500 text-[var(--color-track-blue)]">Did it send?</p>
        <p class="mt-1 font-body text-[var(--color-grey-700)]">Tell us, so we can show the council how many people wrote.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <button type="button" class={btn} data-sent-yes>Yes, I sent it</button>
          <button type="button" class={btnGhost} data-sent-no>Not yet</button>
        </div>
      </div>
      <div class="mt-6 hidden border-l-4 border-[var(--color-track-orange)] bg-[var(--color-grey-100)] p-6" data-sent-thanks>
        <p class="font-heading text-xl font-500 text-[var(--color-track-blue)]">✓ Email sent. Thank you.</p>
        <a href="#share" class={`${btn} mt-4`}>Last step: share</a>
      </div>
    </div>
  </section>

  <!-- STEP 3 · Share -->
  <section id="share" class="scroll-mt-36 bg-[var(--color-paper)] py-[clamp(2.5rem,6vw,4.5rem)]">
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 lg:px-8">
      <p class={eyebrow}>Step 3 of 3 · 10 seconds</p>
      <h2 class={h2}>Send this to three people</h2>
      <p class="mt-3 max-w-2xl font-body text-lg leading-[1.6] text-[var(--color-grey-700)]">One parent WhatsApp group can bring in more voices than a week of posts.</p>
      <div class="mt-6 grid gap-3 sm:flex sm:flex-wrap">
        <a href="#" class={btn} data-share="whatsapp" target="_blank" rel="noopener">Share on WhatsApp</a>
        <button type="button" class={btnGhost} data-share="native" hidden>More ways to share</button>
        <button type="button" class={btnGhost} data-share="copy">Copy link</button>
      </div>
      <p class="mt-3 font-body text-sm text-[var(--color-grey-500)]" data-share-msg aria-live="polite">
        Or post on <a href="#" class="underline" data-share="x" target="_blank" rel="noopener">X</a> or
        <a href="#" class="underline" data-share="facebook" target="_blank" rel="noopener">Facebook</a> with {campaign.hashtag}
      </p>
    </div>
  </section>

  <!-- What's being removed: a real winter session (muted, plays only when on screen) -->
  <section class="bg-[var(--color-track-navy)] text-white">
    <figure class="relative mx-auto max-w-[var(--container-content)]">
      <video
        class="aspect-video w-full object-cover"
        src="/videos/indoor-winter-session.mp4#t=0.3"
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="Young people training together on the indoor track at Willesden Sports Centre on a winter evening"
        data-campaign-video
      ></video>
      <figcaption class="px-6 py-5 lg:absolute lg:bottom-0 lg:left-0 lg:right-0 lg:bg-gradient-to-t lg:from-[var(--color-track-navy)] lg:to-transparent lg:px-8 lg:pb-8 lg:pt-20">
        <p class="font-heading text-[clamp(1.4rem,3.5vw,2.4rem)] font-500 leading-[1.1]">This is what Brent Council is removing.</p>
        <p class="mt-2 font-body text-white/80">A winter session on the indoor track at Willesden Sports Centre.</p>
      </figcaption>
    </figure>
  </section>

  <!-- Why it matters (for people who want the detail) -->
  <section class="bg-white py-[clamp(3rem,7vw,5rem)]">
    <div class="mx-auto grid max-w-[var(--container-content)] gap-10 px-6 lg:grid-cols-[3fr_2fr] lg:px-8">
      <div>
        <p class={eyebrow}>Why it matters</p>
        <h2 class={h2}>The council’s own assessment says who loses most.</h2>
        <div class="mt-6 space-y-4 font-body text-lg leading-[1.65] text-[var(--color-grey-700)]">
          {context.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-8 border-l-4 border-[var(--color-track-orange)] bg-[var(--color-grey-50)] p-6">
          <p class="font-body text-sm font-600 uppercase tracking-[0.05em] text-[var(--color-grey-500)]">What we’re asking for</p>
          <p class="mt-2 font-body text-base leading-[1.6] text-[var(--color-grey-900)]">A written, funded, year-round alternative that:</p>
          <ol class="mt-3 list-decimal space-y-1 pl-5 font-body text-base leading-[1.6] text-[var(--color-grey-700)]">
            {asks.map((a) => <li>{a}</li>)}
          </ol>
        </div>
      </div>
      <dl class="grid grid-cols-2 content-start gap-4">
        {facts.map((f) => (
          <div class="bg-[var(--color-track-blue)] p-5 text-white">
            <dt class="sr-only">{f.label}</dt>
            <dd class="font-heading text-[clamp(2rem,4vw,3rem)] font-600 leading-none tabular-nums">{f.number}</dd>
            <dd class="mt-2 font-body text-sm leading-[1.4] text-white/80">{f.label}</dd>
          </div>
        ))}
        <figure class="col-span-2 mt-2">
          <Image src={GroupPhoto} alt="Track Academy young people and coaches sitting together on the track, smiling and waving" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" class="h-auto w-full" />
          <figcaption class="mt-2 font-body text-sm text-[var(--color-grey-500)]">Some of the young people and coaches who train with Track Academy.</figcaption>
        </figure>
      </dl>
    </div>
  </section>

  <!-- Stories wall (approved only) -->
  <section class="hidden bg-[var(--color-paper)] py-[clamp(3rem,7vw,5rem)]" data-stories-wall>
    <div class="mx-auto max-w-[var(--container-content)] px-6 lg:px-8">
      <p class={eyebrow}>In their words</p>
      <h2 class={h2}>What the track means</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3" data-stories></div>
    </div>
  </section>

  <!-- Want to do more? One accordion, one item open at a time. -->
  <section class="bg-[var(--color-grey-100)] py-[clamp(3rem,7vw,5rem)]">
    <div class="mx-auto max-w-[var(--container-narrow)] px-6 lg:px-8">
      <p class={eyebrow}>Optional</p>
      <h2 class={h2}>Want to do more?</h2>
      <p class="mt-3 font-body text-lg leading-[1.6] text-[var(--color-grey-700)]">Pick one. Each takes a minute or two.</p>
      <div class="mt-8 grid gap-3">
        <details id="survey" name="more" class="group scroll-mt-36 border border-[var(--color-grey-300)] bg-white open:border-[var(--color-track-blue)]" data-survey hidden>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 lg:p-6 [&::-webkit-details-marker]:hidden">
            <span>
              <span class="block font-heading text-[1.25rem] font-500 leading-[1.2] text-[var(--color-track-blue)]">Answer the membership survey</span>
              <span class="mt-1 block font-body text-sm text-[var(--color-grey-700)]">Anonymous, 1 minute. Helps us test the council’s financial case.</span>
            </span>
            <span class="mt-1 font-heading text-2xl leading-none text-[var(--color-track-orange)] transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="border-t border-[var(--color-grey-300)] p-5 lg:p-6">
            <form id="survey-form" class="mt-8 grid gap-6" novalidate>
                <fieldset>
                  <legend class={labelCls}>Do you or your family hold a Willesden Sports Centre membership?</legend>
                  <div class="flex gap-6 font-body">
                    <label class="flex items-center gap-2"><input type="radio" name="is_member" value="yes" required /> Yes</label>
                    <label class="flex items-center gap-2"><input type="radio" name="is_member" value="no" /> No</label>
                  </div>
                </fieldset>

                <div class="hidden grid gap-6" data-branch="member">
                  <div class="grid gap-4 sm:grid-cols-3">
                    <div>
                      <label class={labelCls} for="sv-type">Membership type</label>
                      <select class={input} id="sv-type" name="membership_type">
                        <option value="individual">Individual</option>
                        <option value="family">Family</option>
                        <option value="junior">Junior</option>
                        <option value="concession">Concession</option>
                        <option value="pay_as_you_go">Pay as you go</option>
                        <option value="other">Other</option>
                      </select>
                    </div>
                    <div>
                      <label class={labelCls} for="sv-count">People in your household with a membership</label>
                      <input class={input} id="sv-count" name="members_in_household" type="number" inputmode="numeric" min="1" max="12" value="1" />
                    </div>
                    <div>
                      <label class={labelCls} for="sv-spend">Roughly what your household pays per month</label>
                      <select class={input} id="sv-spend" name="monthly_spend_band">
                        <option value="under_20">Under £20</option>
                        <option value="20_39">£20–£39</option>
                        <option value="40_59">£40–£59</option>
                        <option value="60_99">£60–£99</option>
                        <option value="100_plus">£100+</option>
                        <option value="not_sure">Not sure</option>
                      </select>
                    </div>
                  </div>
                  <fieldset>
                    <legend class={labelCls}>If the indoor track is removed, would you consider cancelling your membership?</legend>
                    <div class="flex gap-6 font-body">
                      <label class="flex items-center gap-2"><input type="radio" name="would_consider_cancelling" value="yes" /> Yes</label>
                      <label class="flex items-center gap-2"><input type="radio" name="would_consider_cancelling" value="maybe" /> Maybe</label>
                      <label class="flex items-center gap-2"><input type="radio" name="would_consider_cancelling" value="no" /> No</label>
                    </div>
                  </fieldset>
                </div>

                <div class="hidden" data-branch="non-member">
                  <fieldset>
                    <legend class={labelCls}>If the indoor track were kept and the facilities improved, would you consider getting a membership?</legend>
                    <div class="flex gap-6 font-body">
                      <label class="flex items-center gap-2"><input type="radio" name="would_consider_joining" value="yes" /> Yes</label>
                      <label class="flex items-center gap-2"><input type="radio" name="would_consider_joining" value="maybe" /> Maybe</label>
                      <label class="flex items-center gap-2"><input type="radio" name="would_consider_joining" value="no" /> No</label>
                    </div>
                  </fieldset>
                </div>

                <label class="flex gap-3 font-body text-sm text-[var(--color-grey-700)]">
                  <input type="checkbox" name="uses_centre_during_sessions" class="mt-1 h-4 w-4 shrink-0" />
                  <span>I use the centre (gym, pool, café) while my child is at Track Academy.</span>
                </label>
                <div class="grid gap-4 sm:grid-cols-[1fr_3fr]">
                  <div>
                    <label class={labelCls} for="sv-pc">First half of postcode <span class="font-400 text-[var(--color-grey-500)]">(optional)</span></label>
                    <input class={input} id="sv-pc" name="postcode_district" maxlength="4" autocapitalize="characters" placeholder="NW10" />
                  </div>
                  <div>
                    <label class={labelCls} for="sv-comment">Anything to add? <span class="font-400 text-[var(--color-grey-500)]">(optional)</span></label>
                    <input class={input} id="sv-comment" name="comment" maxlength="1500" />
                  </div>
                </div>
                <div>
                  <p class="mb-3 font-body text-xs text-[var(--color-grey-500)]">Anonymous. Goes to Track Academy’s campaign team, and only the totals are shared.</p>
                  <button type="submit" class={btn}>Submit</button>
                  <p class="mt-3 font-body text-sm text-[var(--color-track-blue)]" data-form-msg aria-live="polite"></p>
                </div>
              </form>
          </div>
        </details>
        <details id="story" name="more" class="group scroll-mt-36 border border-[var(--color-grey-300)] bg-white open:border-[var(--color-track-blue)]">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 lg:p-6 [&::-webkit-details-marker]:hidden">
            <span>
              <span class="block font-heading text-[1.25rem] font-500 leading-[1.2] text-[var(--color-track-blue)]">Share a longer story</span>
              <span class="mt-1 block font-body text-sm text-[var(--color-grey-700)]">What Track Academy has meant to you. Used as evidence for the council.</span>
            </span>
            <span class="mt-1 font-heading text-2xl leading-none text-[var(--color-track-orange)] transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="border-t border-[var(--color-grey-300)] p-5 lg:p-6">
            <form id="story-form" class="mt-6 grid gap-4" novalidate>
                <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
                <div>
                  <label class={labelCls} for="st-story">What has Track Academy meant to you or your family?</label>
                  <textarea class={input} id="st-story" name="story" rows="5" required minlength="20" maxlength="3000"></textarea>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label class={labelCls} for="st-name">First name to show</label>
                    <input class={input} id="st-name" name="display_name" required maxlength="60" data-me="first_name" />
                  </div>
                  <div>
                    <label class={labelCls} for="st-age">The story is about someone aged</label>
                    <select class={input} id="st-age" name="age_band">
                      <option value="18_plus">18 or over</option>
                      <option value="13_17">13–17</option>
                      <option value="under_13">Under 13</option>
                    </select>
                  </div>
                </div>
                <input type="hidden" name="relationship" data-me="relationship" value="other" />
                <input type="hidden" name="contact_email" data-me="email" value="" />
                <label class="flex gap-3 font-body text-sm text-[var(--color-grey-700)]" data-parent-consent hidden>
                  <input type="checkbox" name="parent_consent" class="mt-1 h-4 w-4 shrink-0" />
                  <span>I’m their parent or carer and I consent to this story being shared.</span>
                </label>
                <label class="flex gap-3 font-body text-sm text-[var(--color-grey-700)]">
                  <input type="checkbox" name="consent_publish" class="mt-1 h-4 w-4 shrink-0" />
                  <span>Track Academy may publish it (first name only) and share it with the council.</span>
                </label>
                <label class="flex gap-3 font-body text-sm text-[var(--color-grey-700)]">
                  <input type="checkbox" name="media_ok" class="mt-1 h-4 w-4 shrink-0" />
                  <span>I’m happy to be asked about speaking to the press.</span>
                </label>
                <p class="font-body text-xs text-[var(--color-grey-500)]" data-story-contact></p>
            <p class="font-body text-xs text-[var(--color-grey-500)]">Goes to Track Academy’s campaign team. Nothing is published until our safeguarding lead approves it.</p>
                <button type="submit" class={`${btn} justify-self-start`}>Send my story</button>
                <p class="font-body text-sm text-[var(--color-track-blue)]" data-form-msg aria-live="polite"></p>
              </form>
          </div>
        </details>
        <details id="skills" name="more" class="group scroll-mt-36 border border-[var(--color-grey-300)] bg-white open:border-[var(--color-track-blue)]">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 lg:p-6 [&::-webkit-details-marker]:hidden">
            <span>
              <span class="block font-heading text-[1.25rem] font-500 leading-[1.2] text-[var(--color-track-blue)]">Offer your skills or contacts</span>
              <span class="mt-1 block font-body text-sm text-[var(--color-grey-700)]">Legal, media, campaigning, or you know a councillor.</span>
            </span>
            <span class="mt-1 font-heading text-2xl leading-none text-[var(--color-track-orange)] transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="border-t border-[var(--color-grey-300)] p-5 lg:p-6">
            <form id="skills-form" class="mt-6 grid gap-4" novalidate>
                <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
                <fieldset>
                  <legend class={labelCls}>I can help with</legend>
                  <div class="grid gap-2 sm:grid-cols-2">
                    {skillOptions.map((s) => (
                      <label class="flex gap-2 font-body text-sm text-[var(--color-grey-700)]">
                        <input type="checkbox" name="skills" value={s.value} class="mt-0.5 h-4 w-4" /> {s.label}
                      </label>
                    ))}
                  </div>
                </fieldset>
                <div>
                  <label class={labelCls} for="sk-details">Tell us more</label>
                  <textarea class={input} id="sk-details" name="details" rows="3" maxlength="2000"></textarea>
                </div>
                <div class="grid gap-4 sm:grid-cols-2" data-skills-identity>
                  <div>
                    <label class={labelCls} for="sk-name">Name</label>
                    <input class={input} id="sk-name" name="full_name" autocomplete="name" required maxlength="120" data-me="name" />
                  </div>
                  <div>
                    <label class={labelCls} for="sk-email">Email</label>
                    <input class={input} id="sk-email" name="email" type="email" inputmode="email" autocomplete="email" required maxlength="200" data-me="email" />
                  </div>
                </div>
                <div>
                  <label class={labelCls} for="sk-phone">Phone <span class="font-400 text-[var(--color-grey-500)]">(optional)</span></label>
                  <input class={input} id="sk-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
                </div>
                <p class="font-body text-xs text-[var(--color-grey-500)]">Goes to Track Academy’s campaign team only. Someone will contact you.</p>
                <button type="submit" class={`${btn} justify-self-start`}>Offer help</button>
                <p class="font-body text-sm text-[var(--color-track-blue)]" data-form-msg aria-live="polite"></p>
              </form>
          </div>
        </details>
        <a href={campaign.donateUrl} target="_blank" rel="noopener" class="group flex items-start justify-between gap-4 border border-[var(--color-grey-300)] bg-white p-5 hover:border-[var(--color-track-blue)] lg:p-6" data-donate>
          <span>
            <span class="block font-heading text-[1.25rem] font-500 leading-[1.2] text-[var(--color-track-blue)]">Donate to Track Academy</span>
            <span class="mt-1 block font-body text-sm text-[var(--color-grey-700)]">Helps keep sessions running for young people while we campaign. Opens our donation page.</span>
          </span>
          <span class="mt-1 font-heading text-2xl leading-none text-[var(--color-track-orange)]" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Campaign contact -->
  <section class="bg-white py-[clamp(2.5rem,6vw,4rem)]">
    <div class="mx-auto flex max-w-[var(--container-narrow)] flex-col gap-6 px-6 sm:flex-row sm:items-center lg:px-8">
      <Image src={ContactPhoto} alt={campaign.contactName} width={160} height={160} class="h-24 w-24 shrink-0 rounded-full object-cover" />
      <div class="flex-1">
        <p class={eyebrow}>Campaign contact</p>
        <p class="font-heading text-[clamp(1.3rem,3vw,1.8rem)] font-500 leading-[1.15] text-[var(--color-track-blue)]">Questions, press or want to help? Talk to {campaign.contactName}.</p>
        <a href={`mailto:${campaign.contactEmail}?subject=${encodeURIComponent('Protect Brent Athletics')}`} class="mt-3 inline-block font-body text-lg font-600 text-[var(--color-track-blue)] underline decoration-[var(--color-track-orange)] decoration-2 underline-offset-4">{campaign.contactEmail}</a>
      </div>
    </div>
  </section>

  <!-- Small print -->
  <section class="bg-[var(--color-grey-100)] py-10">
    <div class="mx-auto max-w-[var(--container-narrow)] space-y-3 px-6 font-body text-sm leading-[1.6] text-[var(--color-grey-500)] lg:px-8">
      <p>Track Academy is a registered charity (1164222). This campaign is about a facility for young people. It is not party political, and we are asking councillors from every party for support.</p>
      <p>How we use your information: petition names and postcodes are given to Brent Council. Emails to councillors are sent from your own email account. Ward lookups use postcodes.io. To save you retyping, this page remembers your details on this device only. Use “Clear my details” to remove them. The membership survey is anonymous. We delete campaign data six months after the campaign ends. See our <a class="underline" href="/privacy">privacy policy</a>.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import { campaign, primaryTargets, wardCouncillors, emailOpeners, emailSubjects, emailBody } from '../../data/campaign';
  import { insert, rpc, getRef, getSessionId, lookupPostcode, supabaseReady, type PostcodeInfo } from '../../lib/campaign-client';

  const ref = getRef();
  const sid = getSessionId();
  const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => [...root.querySelectorAll<T>(s)];
  const pageUrl = `${location.origin}${campaign.slug}`;
  const enc = encodeURIComponent;

  // ================= Remembered details ("me") =================
  // Typed once, carried into every later form, kept on this device so a return visit is pre-filled.
  type Me = { name?: string; email?: string; postcode?: string; relationship?: string; signed?: boolean; emailed?: boolean };
  const STORE = 'ptt_me';
  let me: Me = {};
  try { me = JSON.parse(localStorage.getItem(STORE) || '{}'); } catch {}
  const save = () => { try { localStorage.setItem(STORE, JSON.stringify(me)); } catch {} };
  const firstName = (n?: string) => (n || '').trim().split(/\s+/)[0] || '';

  const valueFor = (key: string) => (key === 'first_name' ? firstName(me.name) : (me as Record<string, string | undefined>)[key] ?? '');

  /** Fill every field bound to `key`, unless the person has typed something different there. */
  function fill(key: string, except?: Element) {
    const v = valueFor(key);
    if (!v) return;
    const keys = key === 'name' ? ['name', 'first_name'] : [key];
    for (const k of keys) {
      for (const el of $$<HTMLInputElement | HTMLSelectElement>(`[data-me="${k}"]`)) {
        if (el === except) continue;
        if (el.value && el.dataset.touched === '1') continue; // respect manual edits
        el.value = k === 'first_name' ? firstName(me.name) : v;
      }
    }
  }
  function fillAll() { for (const k of ['name', 'email', 'postcode', 'relationship']) fill(k); }

  for (const el of $$<HTMLInputElement | HTMLSelectElement>('[data-me]')) {
    const key = el.dataset.me!;
    if (key === 'first_name' || el.type === 'hidden') continue;
    el.addEventListener('input', () => {
      el.dataset.touched = '1';
      (me as Record<string, string>)[key] = el.value.trim();
      save();
      fill(key, el);
      if (key === 'postcode') schedulePostcode(el.value);
      renderEmail();
    });
    el.addEventListener('change', () => el.dispatchEvent(new Event('input')));
  }
  $('[data-not-me]').addEventListener('click', () => {
    try { localStorage.removeItem(STORE); } catch {}
    location.reload();
  });

  // ================= Postcode -> ward =================
  const norm = (w: string) => w.toLowerCase().replace(/&/g, 'and').replace(/[^a-z]/g, '');
  const wardIndex = new Map(Object.entries(wardCouncillors).map(([w, list]) => [norm(w), list]));
  let pc: PostcodeInfo | null = null;
  let pcTimer: number | undefined;
  function schedulePostcode(v: string) {
    clearTimeout(pcTimer);
    pcTimer = window.setTimeout(() => resolvePostcode(v), 350);
  }
  async function resolvePostcode(v: string) {
    pc = v.trim().length >= 5 ? await lookupPostcode(v) : null;
    const note = $('[data-ward-note]');
    if (!pc) note.textContent = v.trim().length >= 5 ? 'Postcode not found. You can still sign.' : '';
    else note.textContent = pc.inBrent && pc.ward ? `${pc.ward} ward, Brent` : `Outside Brent (${pc.district ?? 'unknown'}). Still counts.`;
    renderEmail();
  }

  // ================= Step state =================
  // Ticks finished steps and highlights the next one to do.
  const doneSteps = new Set<string>();
  function markStep(step: 'sign' | 'email' | 'share', done: boolean) {
    if (done) doneSteps.add(step); else doneSteps.delete(step);
    const order = ['sign', 'email', 'share'];
    const next = order.find((s) => !doneSteps.has(s));
    for (const s of order) {
      const a = $(`[data-step-link="${s}"]`);
      a.textContent = a.textContent!.replace(/^✓ /, '');
      if (doneSteps.has(s)) a.textContent = `✓ ${a.textContent}`;
      const active = s === next;
      a.classList.toggle('bg-[var(--color-track-blue)]', active);
      a.classList.toggle('text-white', active);
      a.classList.toggle('bg-[var(--color-grey-100)]', !active);
      a.classList.toggle('text-[var(--color-track-blue)]', !active);
    }
  }
  function showSigned(text?: string) {
    $('#petition-form').classList.add('hidden');
    $('[data-signed]').classList.remove('hidden');
    if (text) $('[data-signed-text]').textContent = text;
    markStep('sign', true);
  }

  // ================= Email builder =================
  const subject = emailSubjects[Math.floor(Math.random() * emailSubjects.length)];
  const nameByEmail = new Map<string, string>();
  for (const t of primaryTargets) nameByEmail.set(t.email.toLowerCase(), t.name);
  for (const list of Object.values(wardCouncillors)) for (const c of list) nameByEmail.set(c.email.toLowerCase(), c.name);

  function recipients() {
    const to = primaryTargets.map((t) => t.email);
    const cc = pc?.inBrent && pc.ward
      ? (wardIndex.get(norm(pc.ward)) ?? []).map((c) => c.email).filter((e) => !to.some((t) => t.toLowerCase() === e.toLowerCase()))
      : [];
    return { to, cc };
  }

  function current() {
    const rel = me.relationship || 'other';
    const personal = ($('#em-personal') as HTMLTextAreaElement).value.trim();
    const place = pc ? (pc.inBrent && pc.ward ? `${pc.ward} ward (${pc.postcode})` : pc.postcode) : '';
    const body = emailBody({
      opener: emailOpeners[rel] ?? emailOpeners.other,
      place,
      personal,
      name: me.name || '',
      postcode: pc?.postcode ?? (me.postcode || '').toUpperCase(),
    });
    return { rel, body, ...recipients() };
  }

  // Collapse "who it's from" to a summary only once we know them (after signing / on return), never mid-typing.
  let showSummary = false;
  function renderEmail() {
    const { body, to, cc } = current();
    // Who it's from
    $('[data-identity-summary]').hidden = !showSummary;
    $('[data-identity-fields]').hidden = showSummary;
    $('[data-summary-name]').textContent = me.name || '';
    $('[data-summary-place]').textContent = pc?.inBrent && pc.ward ? `${pc.ward}, ${pc.postcode}` : (pc?.postcode ?? (me.postcode || '').toUpperCase());
    // Recipients as name chips
    const chip = (email: string, primary: boolean) => {
      const li = document.createElement('li');
      li.className = primary
        ? 'bg-[var(--color-track-blue)] px-3 py-1.5 font-body text-sm text-white'
        : 'border border-[var(--color-grey-300)] bg-white px-3 py-1.5 font-body text-sm text-[var(--color-grey-900)]';
      li.textContent = nameByEmail.get(email.toLowerCase()) ?? email;
      li.title = email;
      return li;
    };
    $('[data-recipients]').replaceChildren(...to.map((e) => chip(e, true)), ...cc.map((e) => chip(e, false)));
    $('[data-recipients-note]').textContent = cc.length
      ? `The two Cabinet members, plus your ${pc?.ward} ward councillors, who represent you.`
      : pc && !pc.inBrent
        ? 'The two Cabinet members responsible. (You’re outside Brent, so no ward councillors are added.)'
        : 'The two Cabinet members responsible. Add a Brent postcode to include your own ward councillors.';
    $('[data-subject]').textContent = subject;
    $('[data-body]').textContent = body;
  }
  $('[data-identity-edit]').addEventListener('click', () => {
    showSummary = false;
    renderEmail();
    $('#em-name').focus();
  });
  $('#em-personal').addEventListener('input', renderEmail);

  function logEmail(action: 'email_opened' | 'email_sent', method: string) {
    const { rel, to, cc } = current();
    insert('campaign_actions', {
      action, method, ref, session_id: sid, relationship: rel,
      ward: pc?.inBrent ? pc.ward : null, in_brent: pc?.inBrent ?? null, recipients: to.length + cc.length,
    });
  }

  /** Clipboard with a fallback for older phones and in-app browsers (e.g. Instagram, WhatsApp). */
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;opacity:0';
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    }
  }

  /** If they ticked the box, their email line also becomes a story (once per wording), pending DSL review. */
  let savedStory = '';
  function saveLineAsStory() {
    const line = ($('#em-personal') as HTMLTextAreaElement).value.trim();
    if (!($('#em-story-ok') as HTMLInputElement).checked || line.length < 20 || line === savedStory) return;
    savedStory = line;
    const isParent = me.relationship === 'parent';
    insert('campaign_stories', {
      display_name: firstName(me.name) || 'Supporter',
      relationship: me.relationship || 'other',
      // A parent's line is usually about their child, so it is flagged for a safeguarding check.
      age_band: isParent ? 'unknown' : '18_plus',
      parent_consent: isParent,
      consent_publish: true,
      media_ok: false,
      story: line,
      contact_email: me.email?.toLowerCase() || null,
      ref: ref ? `${ref}:email-line` : 'email-line',
    });
  }

  let lastMethod = 'mailto';
  for (const el of $$('[data-send]')) {
    el.addEventListener('click', async (e) => {
      const method = el.dataset.send!;
      if (!me.name || !me.postcode) {
        e.preventDefault();
        showSummary = false;
        renderEmail();
        const missing = !me.name ? '#em-name' : '#em-postcode';
        $(missing).focus();
        $('[data-copy-note]').textContent = 'Add your name and postcode first. Councillors only act on emails from real residents.';
        return;
      }
      const { body, to, cc } = current();
      const bcc = campaign.bccInbox ? [campaign.bccInbox] : [];
      if (method === 'mailto') {
        (el as HTMLAnchorElement).href =
          `mailto:${to.join(',')}?subject=${enc(subject)}&body=${enc(body)}` +
          (cc.length ? `&cc=${cc.join(',')}` : '') + (bcc.length ? `&bcc=${bcc.join(',')}` : '');
      } else if (method === 'gmail') {
        (el as HTMLAnchorElement).href =
          `https://mail.google.com/mail/?view=cm&fs=1&to=${enc(to.join(','))}&cc=${enc(cc.join(','))}&bcc=${enc(bcc.join(','))}&su=${enc(subject)}&body=${enc(body)}`;
      } else if (method === 'outlook') {
        (el as HTMLAnchorElement).href =
          `https://outlook.live.com/mail/0/deeplink/compose?to=${enc(to.join(';'))}&cc=${enc(cc.join(';'))}&bcc=${enc(bcc.join(';'))}&subject=${enc(subject)}&body=${enc(body)}`;
      }
      lastMethod = method;
      logEmail('email_opened', method);
      saveLineAsStory();
      setTimeout(() => $('[data-confirm-sent]').classList.remove('hidden'), 1500);
      if (method === 'copy') {
        const ok = await copyText(`To: ${to.join(', ')}${cc.length ? `\nCc: ${cc.join(', ')}` : ''}\nSubject: ${subject}\n\n${body}`);
        $('[data-copy-note]').textContent = ok
          ? 'Copied, with the addresses. Paste into a new email and send.'
          : 'Couldn’t copy automatically. Open “Preview the full email” and copy it from there.';
      } else {
        $('[data-copy-note]').textContent = '';
      }
    });
  }
  function showEmailed() {
    $('[data-confirm-sent]').classList.add('hidden');
    $('[data-sent-thanks]').classList.remove('hidden');
    markStep('email', true);
  }
  $('[data-sent-yes]').addEventListener('click', () => {
    logEmail('email_sent', lastMethod);
    me.emailed = true;
    save();
    showEmailed();
  });
  $('[data-sent-no]').addEventListener('click', () => $('[data-confirm-sent]').classList.add('hidden'));

  // ================= Generic form helper =================
  function wire(id: string, handler: (fd: FormData, f: HTMLFormElement) => Promise<string | null>) {
    const f = $<HTMLFormElement>(id);
    const msg = $('[data-form-msg]', f);
    const button = $<HTMLButtonElement>('button[type=submit]', f);
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(f);
      if (fd.get('website')) return; // bot honeypot
      if (!f.checkValidity()) { f.reportValidity(); return; }
      button.disabled = true;
      msg.textContent = 'Sending…';
      const err = await handler(fd, f);
      button.disabled = false;
      msg.textContent = err ?? '';
    });
    return f;
  }
  const offline = 'We couldn’t save this just now. Please try again, or email ' + campaign.contactEmail + '.';
  const done = (f: HTMLFormElement, text: string) => {
    f.innerHTML = `<p class="font-heading text-xl text-[var(--color-track-blue)]">✓ ${text}</p>`;
  };

  // Step 1 · Petition
  wire('#petition-form', async (fd) => {
    const info = pc && norm(pc.postcode) === norm(String(fd.get('postcode'))) ? pc : await lookupPostcode(String(fd.get('postcode')));
    if (info) pc = info;
    const r = await insert('petition_signatures', {
      full_name: String(fd.get('full_name')).trim(),
      email: String(fd.get('email')).trim().toLowerCase(),
      postcode: info?.postcode ?? String(fd.get('postcode')).trim().toUpperCase(),
      ward: info?.inBrent ? info.ward : null,
      in_brent: info?.inBrent ?? null,
      relationship: fd.get('relationship'),
      consent_council: fd.get('consent_council') === 'on',
      consent_updates: fd.get('consent_updates') === 'on',
      ref,
    });
    if (r.ok || r.duplicate) {
      me.signed = true;
      save();
      fillAll();
      showSummary = Boolean(me.name && me.postcode);
      if (me.email) $('[data-story-contact]').textContent = `We’ll contact you at ${me.email} if we need to check anything.`;
      renderEmail();
      showSigned(r.duplicate ? 'You’d already signed. Thank you.' : `Signed. Thank you, ${firstName(me.name)}.`);
      loadStats();
      // Move them straight on to the higher-impact step.
      setTimeout(() => $('#email').scrollIntoView({ behavior: 'smooth' }), 900);
      return null;
    }
    return offline;
  });

  // Story
  const ageSel = $<HTMLSelectElement>('#st-age');
  const parentBox = $('[data-parent-consent]');
  ageSel.addEventListener('change', () => {
    const child = ageSel.value !== '18_plus';
    parentBox.hidden = !child;
    $<HTMLInputElement>('input', parentBox).required = child;
  });
  wire('#story-form', async (fd, f) => {
    const r = await insert('campaign_stories', {
      display_name: firstName(String(fd.get('display_name'))),
      relationship: me.relationship || 'other',
      age_band: fd.get('age_band'),
      story: String(fd.get('story')).trim(),
      contact_email: me.email?.toLowerCase() || null,
      consent_publish: fd.get('consent_publish') === 'on',
      parent_consent: fd.get('parent_consent') === 'on',
      media_ok: fd.get('media_ok') === 'on',
      ref,
    });
    if (r.ok) { done(f, 'Thank you. We’ll check your story and get in touch if we need anything.'); return null; }
    return offline;
  });

  // Skills
  wire('#skills-form', async (fd, f) => {
    if (!fd.getAll('skills').length && !String(fd.get('details') || '').trim()) return 'Tick at least one thing you can help with.';
    const r = await insert('campaign_offers', {
      full_name: String(fd.get('full_name')).trim(),
      email: String(fd.get('email')).trim().toLowerCase(),
      phone: String(fd.get('phone') || '').trim() || null,
      skills: fd.getAll('skills'),
      details: String(fd.get('details') || '').trim() || null,
      ref,
    });
    if (r.ok) { done(f, 'Thank you. Someone from the campaign team will be in touch.'); return null; }
    return offline;
  });

  // Survey (date-gated, anonymous: deliberately not pre-filled)
  const surveyOpen = new Date() >= new Date(`${campaign.surveyOpensOn}T00:00:00`) || new URLSearchParams(location.search).has('survey');
  if (surveyOpen) $('[data-survey]').hidden = false;
  // Links like /protect-brent-athletics#survey open that item.
  const openFromHash = () => {
    if (!/^#(survey|story|skills)$/.test(location.hash)) return;
    const d = document.querySelector<HTMLDetailsElement>(`details${location.hash}`);
    if (d && !d.hidden) { d.open = true; d.scrollIntoView({ behavior: 'smooth' }); }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
  const sForm = $<HTMLFormElement>('#survey-form');
  for (const r of $$<HTMLInputElement>('input[name=is_member]', sForm)) {
    r.addEventListener('change', () => {
      const member = r.value === 'yes' && r.checked;
      $('[data-branch=member]', sForm).classList.toggle('hidden', !member);
      $('[data-branch=non-member]', sForm).classList.toggle('hidden', member);
    });
  }
  wire('#survey-form', async (fd, f) => {
    try { if (localStorage.getItem('ptt_survey_done')) return 'You’ve already answered on this device. Thank you.'; } catch {}
    const isMember = fd.get('is_member') === 'yes';
    const answer = isMember ? fd.get('would_consider_cancelling') : fd.get('would_consider_joining');
    if (!answer) return 'Please answer the second question.';
    const r = await insert('membership_survey', {
      is_member: isMember,
      membership_type: isMember ? fd.get('membership_type') : null,
      members_in_household: isMember ? Number(fd.get('members_in_household') || 1) : null,
      monthly_spend_band: isMember ? fd.get('monthly_spend_band') : null,
      would_consider_cancelling: isMember ? answer : null,
      would_consider_joining: isMember ? null : answer,
      uses_centre_during_sessions: fd.get('uses_centre_during_sessions') === 'on',
      postcode_district: String(fd.get('postcode_district') || '').trim().toUpperCase().slice(0, 4) || null,
      comment: String(fd.get('comment') || '').trim() || null,
      ref, session_id: sid,
    });
    if (r.ok) {
      try { localStorage.setItem('ptt_survey_done', '1'); } catch {}
      done(f, 'Thank you. Your answer has been recorded anonymously.');
      return null;
    }
    return offline;
  });

  // ================= Share =================
  const shareUrl = `${pageUrl}?ref=share`;
  const text = `${campaign.shareText} ${shareUrl}`;
  $<HTMLAnchorElement>('[data-share=whatsapp]').href = `https://wa.me/?text=${enc(text)}`;
  $<HTMLAnchorElement>('[data-share=x]').href = `https://twitter.com/intent/tweet?text=${enc(`${campaign.shareText} ${campaign.hashtag}`)}&url=${enc(shareUrl)}`;
  $<HTMLAnchorElement>('[data-share=facebook]').href = `https://www.facebook.com/sharer/sharer.php?u=${enc(shareUrl)}`;
  const nativeBtn = $<HTMLButtonElement>('[data-share=native]');
  if (navigator.share) nativeBtn.hidden = false;
  for (const el of $$('[data-share]')) {
    el.addEventListener('click', async () => {
      const kind = el.dataset.share!;
      if (kind === 'copy') {
        const ok = await copyText(shareUrl);
        el.textContent = ok ? 'Link copied ✓' : shareUrl;
      }
      if (kind === 'native') {
        try { await navigator.share({ title: campaign.headline, text: campaign.shareText, url: shareUrl }); } catch { return; }
      }
      markStep('share', true);
      insert('campaign_actions', { action: `share_${kind}`, ref, session_id: sid });
    });
  }

  // ================= Live numbers =================
  type Stats = { petition: number; emails_sent: number; wards_reached: number; stories: { display_name: string; relationship: string; story: string }[] };
  async function loadStats() {
    if (!supabaseReady) return;
    try {
      const s = await rpc<Stats>('campaign_public_stats');
      if (!s) return;
      for (const el of $$('[data-stat]')) {
        const k = el.dataset.stat as keyof Stats;
        el.textContent = Number(s[k] ?? 0).toLocaleString('en-GB');
      }
      if (s.petition + s.emails_sent >= 25) $('[data-live-counter]').hidden = false; // hide tiny numbers
      if (s.petition >= 25) {
        $('[data-petition-progress]').hidden = false;
        $('[data-progress-bar]').style.width = `${Math.min(100, (s.petition / campaign.petitionTarget) * 100)}%`;
      }
      if (s.stories?.length) {
        $('[data-stories]').replaceChildren(
          ...s.stories.map((st) => {
            const card = document.createElement('blockquote');
            card.className = 'bg-white p-6 font-body text-[var(--color-grey-900)]';
            const p = document.createElement('p');
            p.className = 'leading-[1.6]';
            p.textContent = `“${st.story}”`;
            const c = document.createElement('footer');
            c.className = 'mt-4 text-sm font-600 text-[var(--color-track-blue)]';
            c.textContent = `— ${st.display_name}`;
            card.append(p, c);
            return card;
          }),
        );
        $('[data-stories-wall]').classList.remove('hidden');
      }
    } catch { /* numbers are a bonus */ }
  }

  // ================= Video =================
  const video = document.querySelector<HTMLVideoElement>('[data-campaign-video]');
  if (video) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) video.controls = true;
    else if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => (e.isIntersecting ? video.play().catch(() => {}) : video.pause()), { threshold: 0.4 }).observe(video);
    }
  }

  // ================= Start-up =================
  fillAll();
  if (me.postcode) resolvePostcode(me.postcode);
  showSummary = Boolean(me.signed && me.name && me.postcode);
  if (me.signed) showSigned(me.name ? `You’ve signed, ${firstName(me.name)}. Thank you.` : undefined);
  if (me.emailed) showEmailed();
  if (me.email) $('[data-story-contact]').textContent = `We’ll contact you at ${me.email} if we need to check anything.`;
  // Returning signers (e.g. from a reminder email linking to #email) land on step 2.
  if (me.signed && !me.emailed && !location.hash) $('#email').scrollIntoView();
  renderEmail();
  loadStats();
</script>
