---
/**
 * Header.astro — clear primary navigation with accessible desktop dropdowns and mobile menu.
 */
const navItems = [
  {
    label: 'About',
    href: '/about',
    children: [
      { label: 'About Us', href: '/about' },
      { label: 'Our Impact', href: '/impact' },
      { label: 'Meet the Team', href: '/team' },
      { label: 'Safeguarding', href: '/safeguarding' },
    ],
  },
  {
    label: 'Programmes',
    href: '/athletics',
    children: [
      { label: 'Athletics Training', href: '/athletics' },
      { label: 'Education', href: '/education' },
      { label: 'Life Skills', href: '/life-skills' },
      { label: 'Mentoring', href: '/mentoring' },
      { label: 'Holiday Programmes', href: '/holiday-programmes' },
      { label: 'Competitions & Fixtures', href: '/competitions' },
      { label: 'Performance Coaching', href: '/performance-coaching' },
    ],
  },
  { label: 'Schools', href: '/schools' },
  { label: 'Events', href: '/events' },
  { label: 'Impact', href: '/impact' },
  { label: 'Contact', href: '/contact' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-200 ease-[var(--ease-sprint)]"
  data-state="top"
>
  <div class="mx-auto flex max-w-[var(--container-content)] items-center justify-between px-6 py-3 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center" aria-label="Track Academy home">
      <img src="/logo-white.png" alt="Track Academy" class="h-14 w-auto transition-opacity duration-200 header-logo-light lg:h-16" />
      <img src="/logo.png" alt="Track Academy" class="hidden h-14 w-auto transition-opacity duration-200 header-logo-dark lg:h-16" />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main navigation">
      {navItems.map((item) => (
        <div class="group relative">
          <a href={item.href} class="header-nav-link font-body text-sm font-semibold text-white/90 transition-colors duration-150 hover:text-white">
            {item.label}
          </a>
          {item.children && (
            <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-all duration-200 ease-[var(--ease-settle)] group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="tracked-surface min-w-[230px] bg-[var(--color-track-blue)] py-2 shadow-xl">
                {item.children.map((child) => (
                  <a href={child.href} class="block px-5 py-2.5 font-body text-sm text-white/80 transition-colors duration-150 hover:bg-white/10 hover:text-white focus:bg-white/10 focus:text-white">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href="/support" class="header-nav-link font-body text-sm font-semibold text-white/90 transition-colors hover:text-white">Support</a>
      <a href="/register" class="bg-[var(--color-track-orange)] px-6 py-2.5 font-body text-sm font-semibold uppercase tracking-wide text-white transition-all duration-150 ease-[var(--ease-sprint)] hover:bg-[var(--color-accent-dark)] active:scale-[0.98]">Register</a>
    </div>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex min-h-11 min-w-11 flex-col items-center justify-center gap-1.5 lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="header-bar block h-0.5 w-6 bg-white transition-all duration-200"></span>
      <span class="header-bar block h-0.5 w-6 bg-white transition-all duration-200"></span>
      <span class="header-bar block h-0.5 w-6 bg-white transition-all duration-200"></span>
    </button>
  </div>
</header>

<div id="mobile-menu" class="tracked-surface fixed inset-0 z-40 hidden bg-[var(--color-track-blue)]" aria-hidden="true">
  <nav class="flex h-full flex-col overflow-y-auto px-6 pb-10 pt-24" aria-label="Mobile navigation">
    {navItems.map((item) => (
      <div class="border-b border-white/10 py-4">
        <a href={item.href} class="font-heading text-2xl font-medium text-white">{item.label}</a>
        {item.children && (
          <div class="mt-2 pl-4">
            {item.children.map((child) => (
              <a href={child.href} class="block py-2 font-body text-base text-white/70 hover:text-white focus:text-white">{child.label}</a>
            ))}
          </div>
        )}
      </div>
    ))}
    <div class="mt-8 flex gap-4">
      <a href="/register" class="flex-1 bg-[var(--color-track-orange)] px-6 py-4 text-center font-body text-sm font-semibold uppercase tracking-wide text-white">Register</a>
      <a href="/support" class="flex-1 border-2 border-white px-6 py-4 text-center font-body text-sm font-semibold uppercase tracking-wide text-white">Support</a>
    </div>
  </nav>
</div>

<script>
  const header = document.getElementById('site-header');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  let previousFocus = null;

  function updateHeader() {
    header?.setAttribute('data-state', window.scrollY > 80 ? 'scrolled' : 'top');
  }

  function getFocusableElements() {
    if (!mobileMenu) return [];
    return Array.from(mobileMenu.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'));
  }

  function setMenu(open) {
    if (!mobileMenu || !mobileToggle) return;
    if (open) {
      previousFocus = document.activeElement;
      mobileMenu.classList.remove('hidden');
      mobileMenu.setAttribute('aria-hidden', 'false');
      mobileToggle.setAttribute('aria-expanded', 'true');
      mobileToggle.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
      const first = getFocusableElements()[0];
      if (first instanceof HTMLElement) first.focus();
    } else {
      mobileMenu.classList.add('hidden');
      mobileMenu.setAttribute('aria-hidden', 'true');
      mobileToggle.setAttribute('aria-expanded', 'false');
      mobileToggle.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
      if (previousFocus instanceof HTMLElement) previousFocus.focus();
    }
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  mobileToggle?.addEventListener('click', () => {
    const isOpen = mobileToggle.getAttribute('aria-expanded') === 'true';
    setMenu(!isOpen);
  });

  document.addEventListener('keydown', (event) => {
    if (!mobileToggle || mobileToggle.getAttribute('aria-expanded') !== 'true') return;

    if (event.key === 'Escape') {
      event.preventDefault();
      setMenu(false);
      return;
    }

    if (event.key === 'Tab') {
      const focusable = getFocusableElements();
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        if (last instanceof HTMLElement) last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        if (first instanceof HTMLElement) first.focus();
      }
    }
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>

<style>
  #site-header[data-state='top'] { background-color: transparent; }
  #site-header[data-state='scrolled'] {
    background-color: var(--color-track-blue);
    box-shadow: 0 1px 0 0 rgba(255, 255, 255, 0.1);
  }

  .header-nav-link { position: relative; }
  .header-nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 2px;
    background-color: var(--color-track-orange);
    transition: width 200ms var(--ease-sprint);
  }
  .header-nav-link:hover::after,
  .header-nav-link:focus-visible::after { width: 100%; }
</style>
