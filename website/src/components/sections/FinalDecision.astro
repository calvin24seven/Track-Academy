---
/** FinalDecision.astro — closing conversion choice, not a generic CTA band. */
import Button from '../ui/Button.astro';
---

<section class="tracked-surface overflow-hidden bg-[var(--color-track-navy)] py-[clamp(4rem,9vw,7rem)]">
  <div class="mx-auto max-w-[var(--container-content)] px-6 lg:px-8">
    <div class="mb-10 max-w-2xl lg:mb-14">
      <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[-0.05em] text-[var(--color-track-gold)]">Your next step</p>
      <h2 class="font-heading text-[clamp(2rem,5vw,3.5rem)] font-500 leading-[1.02] tracking-[-0.025em] text-white">There is more than one way to make a difference.</h2>
    </div>
    <div class="grid gap-px bg-white/20 lg:grid-cols-2">
      <div class="bg-[var(--color-track-blue)] p-7 sm:p-10 lg:p-12">
        <p class="font-heading text-[clamp(3.5rem,8vw,6rem)] font-500 leading-none text-[var(--color-track-gold)]">01</p>
        <h3 class="mt-8 font-heading text-[clamp(1.75rem,3vw,2.5rem)] font-500 leading-[1.05] text-white">Bring a young person to the track.</h3>
        <p class="mt-4 max-w-md font-body leading-[1.65] text-white/75">Athletics, education and mentoring for young people aged 5–23 in Brent. £25 a term, with free places available through financial support.</p>
        <div class="mt-8"><Button href="https://app.upshot.org.uk/signup/c1ac4dca/39e743a525f9f4b5/" label="Register a child" variant="primary" external /></div>
      </div>
      <div class="bg-[var(--color-track-navy)] p-7 sm:p-10 lg:p-12">
        <p class="font-heading text-[clamp(3.5rem,8vw,6rem)] font-500 leading-none text-[var(--color-track-gold)]">02</p>
        <h3 class="mt-8 font-heading text-[clamp(1.75rem,3vw,2.5rem)] font-500 leading-[1.05] text-white">Bring Track Academy to your school.</h3>
        <p class="mt-4 max-w-md font-body leading-[1.65] text-white/75">A practical partnership that combines sport, mentoring and measurable outcomes for young people who benefit most from extra support.</p>
        <div class="mt-8"><Button href="/contact" label="Start a partnership conversation" variant="inverse" /></div>
      </div>
    </div>
  </div>
</section>
