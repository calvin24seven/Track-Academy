---
/** ProgrammeEditorial.astro — a hierarchy-led programme composition. */
import { Image } from 'astro:assets';
import MentoringConversation from '../../assets/programme/mentoring-conversation.jpg';

const programmes = [
  {
    title: 'Athletics',
    description: 'Running, jumping and throwing three times a week at Willesden Sports Centre. Ages 5–23.',
    href: '/athletics',
    image: (await import('../../assets/programme/ready-to-race.jpg')).default,
    alt: 'Young athletes training together on an athletics track',
  },
  {
    title: 'Education',
    description: 'Free Saturday tuition in maths, English and science, built around confidence in learning.',
    href: '/education',
    image: (await import('../../assets/programme/students-learning.jpg')).default,
    alt: 'Young people working together during an education session',
  },
  {
    title: 'Life Skills',
    description: 'Practical skills for communication, resilience and taking the next step with confidence.',
    href: '/life-skills',
    image: (await import('../../assets/website-2026/children-learning-with-tutor.jpg')).default,
    alt: 'A young person learning alongside a tutor at Track Academy',
  },
  {
    title: 'Mentoring',
    description: 'One-to-one support from a trusted adult who gets to know the young person behind the athlete.',
    href: '/mentoring',
    image: MentoringConversation,
    alt: 'A Track Academy mentor and young person talking together',
  },
  {
    title: 'Holiday Programmes',
    description: 'Workshops, trips and active days that keep young people connected when school is out.',
    href: '/holiday-programmes',
    image: (await import('../../assets/stories/group-photo.jpg')).default,
    alt: 'Track Academy young people together at a holiday programme',
  },
];
---

<section class="bg-white py-[clamp(4rem,9vw,8rem)]">
  <div class="mx-auto max-w-[var(--container-content)] px-6 lg:px-8">
    <div class="mb-[clamp(2.5rem,5vw,4rem)] grid gap-5 lg:grid-cols-[7fr_5fr] lg:items-end">
      <p class="font-body text-sm font-semibold uppercase tracking-[-0.05em] text-[var(--color-track-orange)]">What happens here</p>
      <h2 class="max-w-2xl font-heading text-[clamp(1.9rem,5vw,3.35rem)] font-500 leading-[1.04] tracking-[-0.025em] text-[var(--color-track-blue)]">Athletics opens the door. What happens next changes the trajectory.</h2>
    </div>

    <div class="grid gap-6 lg:grid-cols-[7fr_5fr] lg:gap-10">
      <a href={programmes[0].href} class="group block overflow-hidden bg-[var(--color-track-blue)] text-white">
        <div class="relative aspect-[16/11] overflow-hidden">
          <Image src={programmes[0].image} alt={programmes[0].alt} class="h-full w-full object-cover transition-transform duration-[800ms] ease-[var(--ease-rest)] group-hover:scale-[1.035]" loading="lazy" widths={[640, 960, 1280]} sizes="(max-width: 1024px) 100vw, 58vw" />
          <div class="absolute inset-0 bg-[var(--color-track-navy)]/20"></div>
          <span class="absolute left-5 top-5 flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-track-gold)] font-heading text-lg font-500 text-[var(--color-track-navy)]">01</span>
        </div>
        <div class="grid gap-5 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <h3 class="font-heading text-[clamp(1.75rem,3vw,2.5rem)] font-500 leading-[1.05]">{programmes[0].title}</h3>
            <p class="mt-3 max-w-xl font-body leading-[1.6] text-white/75">{programmes[0].description}</p>
          </div>
          <span class="font-body text-sm font-semibold uppercase tracking-wide text-[var(--color-track-gold)]">Explore athletics →</span>
        </div>
      </a>

      <div class="divide-y divide-[var(--color-grey-300)] border-y border-[var(--color-grey-300)]">
        {programmes.slice(1).map((programme, index) => (
          <a href={programme.href} class="group grid grid-cols-[5.25rem_1fr] gap-5 py-6 sm:grid-cols-[7rem_1fr] sm:gap-6 sm:py-7">
            <div class="aspect-square overflow-hidden bg-[var(--color-grey-100)]">
              <Image src={programme.image} alt={programme.alt} class="h-full w-full object-cover transition-transform duration-[600ms] ease-[var(--ease-rest)] group-hover:scale-105" loading="lazy" widths={[160, 240, 360]} sizes="112px" />
            </div>
            <div class="flex flex-col justify-center">
              <div class="flex items-center gap-3"><span class="font-heading text-sm font-500 text-[var(--color-track-gold)]">0{index + 2}</span><h3 class="font-heading text-xl font-500 leading-[1.1] text-[var(--color-track-blue)]">{programme.title}</h3></div>
              <p class="mt-2 font-body text-sm leading-[1.55] text-[var(--color-grey-700)]">{programme.description}</p>
              <span class="mt-3 font-body text-xs font-semibold uppercase tracking-wide text-[var(--color-track-orange)]">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8 lg:mt-10"><a href="/athletics" class="inline-flex items-center gap-2 font-body text-sm font-semibold text-[var(--color-track-blue)] transition-colors duration-150 hover:text-[var(--color-track-orange)]">Explore all programmes →</a></div>
  </div>
</section>
