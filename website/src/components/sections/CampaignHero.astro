---
/**
 * CampaignHero.astro — homepage "takeover" hero for Protect Brent Athletics.
 * Same visual language as TrackEntranceHero (full-bleed photo, type in the image, lane line),
 * so the homepage still feels like Track Academy. Switch off with campaign.homepageTakeover.
 */
import { Image } from 'astro:assets';
import Photo from '../../assets/campaign/indoor-race-girl.jpg';
import Button from '../ui/Button.astro';
import { campaign } from '../../data/campaign';
---

<section class="relative h-[88svh] min-h-[600px] w-full overflow-hidden lg:h-[100svh]">
  <div class="absolute inset-0 animate-blur-in">
    <Image
      src={Photo}
      alt="A young athlete sprinting on the indoor track at Willesden Sports Centre during a competition"
      class="h-full w-full object-cover object-[60%_35%]"
      loading="eager"
      fetchpriority="high"
      widths={[375, 640, 1024, 1920]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-[var(--color-track-navy)]/45"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[rgba(10,28,95,0.85)] via-[rgba(10,28,95,0.35)] to-transparent"></div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 top-[7rem] flex flex-col justify-end px-6 pb-14 lg:justify-center lg:px-8 lg:pb-20">
    <div class="mx-auto w-full max-w-[var(--container-content)]">
      <div class="max-w-3xl">
        <p class="mb-5 flex items-center gap-3 font-body text-xs font-semibold uppercase tracking-[0.13em] text-white/90">
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-track-orange)] opacity-75 motion-reduce:animate-none"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[var(--color-track-orange)]"></span>
          </span>
          Campaign · {campaign.hashtag}
        </p>
        <h1
          class="animate-mask-reveal font-heading text-[clamp(2.9rem,7vw,5.75rem)] font-500 leading-[0.98] tracking-[-0.035em] text-white"
          style="animation-delay: 300ms; animation-fill-mode: both;"
        >
          Save athletics in Brent.
        </h1>
        <p
          class="mt-6 max-w-xl animate-scale-in font-body text-[clamp(1.05rem,1.5vw,1.3rem)] leading-[1.55] text-white/90"
          style="animation-delay: 500ms; animation-fill-mode: both;"
        >
          Brent Council is removing the indoor track at Willesden Sports Centre, used by 400+ young people. Add your name, then tell your councillors.
        </p>

        <p class="mt-6 hidden items-center gap-3 font-body text-white animate-scale-in" style="animation-delay: 600ms; animation-fill-mode: both;" data-hero-count>
          <strong class="font-heading text-[1.75rem] font-600 leading-none tabular-nums" data-hero-number></strong>
          <span class="text-white/80">people have signed</span>
        </p>

        <div
          class="mt-8 flex flex-col gap-4 animate-scale-in sm:flex-row sm:items-center"
          style="animation-delay: 700ms; animation-fill-mode: both;"
        >
          <Button href={`${campaign.slug}/?ref=homepage#sign`} label="Sign the petition" variant="primary" size="default" />
          <a href={`${campaign.slug}/stories/`} class="font-body text-sm font-semibold text-white underline decoration-[var(--color-track-gold)] decoration-2 underline-offset-8 transition-colors hover:text-[var(--color-track-gold)]">Read their stories →</a>
        </div>
      </div>
    </div>
  </div>

  <a href="#about-track-academy" class="absolute bottom-5 right-6 hidden font-body text-xs font-semibold uppercase tracking-[0.1em] text-white/70 transition-colors hover:text-white lg:right-8 lg:block">
    About Track Academy ↓
  </a>
  <div class="absolute bottom-0 left-0 right-0 lane-line"></div>
</section>
<div id="about-track-academy" class="scroll-mt-24"></div>

<script>
  import { rpc } from '../../lib/campaign-client';
  // Live signature count in the hero (shown once it's a meaningful number).
  rpc<{ petition: number }>('campaign_public_stats')
    .then((s) => {
      if (!s || s.petition < 25) return;
      document.querySelector('[data-hero-number]')!.textContent = s.petition.toLocaleString('en-GB');
      const el = document.querySelector<HTMLElement>('[data-hero-count]')!;
      el.classList.remove('hidden');
      el.classList.add('flex');
    })
    .catch(() => {});
</script>
